@{
    ViewData["Title"] = "Reportes";
}

<div class="container-fluid">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Centro de Reportes Institucionales
            </h2>

            <p class="text-muted">
                Reportería ejecutiva y exportaciones institucionales
            </p>

        </div>

        <div class="d-flex gap-2">

            <a class="btn btn-outline-primary" href="/api/reportes/inventario/excel">

                <i class="bi bi-file-earmark-excel"></i>
                Exportar Excel

            </a>

            <a class="btn btn-outline-danger" href="/api/reportes/inventario/pdf">

                <i class="bi bi-file-earmark-pdf"></i>
                Exportar PDF

            </a>

        </div>

    </div>

    <!-- REPORT CARDS -->

    <div class="row g-4">

        <div class="col-lg-4">

            <div class="report-card">

                <div class="report-icon blue">

                    <i class="bi bi-box-seam-fill"></i>

                </div>

                <h5>
                    Inventario General
                </h5>

                <p class="text-muted">
                    Reporte completo de bienes institucionales
                </p>

                <button class="btn btn-primary w-100">

                    Generar Reporte

                </button>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="report-card">

                <div class="report-icon green">

                    <i class="bi bi-person-check-fill"></i>

                </div>

                <h5>
                    Bienes por Responsable
                </h5>

                <p class="text-muted">
                    Control patrimonial por usuario responsable
                </p>

                <button class="btn btn-success w-100">

                    Generar Reporte

                </button>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="report-card">

                <div class="report-icon orange">

                    <i class="bi bi-tools"></i>

                </div>

                <h5>
                    Bienes en Reparación
                </h5>

                <p class="text-muted">
                    Activos dañados o en mantenimiento
                </p>

                <a class="btn btn-warning w-100 text-white" href="/api/reportes/inventario/pdf?status=En%20reparación">

                    Generar Reporte

                </a>

            </div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.report-card .btn').forEach(button => {
                if (!button.href) button.addEventListener('click', () => window.location.href = '/api/reportes/inventario/excel');
            });
        });
    </script>
}

        </div>

    </div>

    <!-- TABLA -->

    <div class="card-custom mt-4">

        <div class="card-header-custom">

            Historial de Reportes Generados

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Reporte</th>
                        <th>Usuario</th>
                        <th>Formato</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Descargar</th>

                    </tr>

                </thead>

                <tbody>

                    <tr>

                        <td>Inventario General</td>

                        <td>Juan Pérez</td>

                        <td>

                            <span class="badge bg-success">
                                Excel
                            </span>

                        </td>

                        <td>28/05/2026</td>

                        <td>

                            <span class="badge bg-primary">
                                Completado
                            </span>

                        </td>

                        <td>

                            <button class="btn btn-sm btn-light">

                                <i class="bi bi-download"></i>

                            </button>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>