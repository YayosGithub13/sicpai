@{
    ViewData["Title"] = "Reportes";
}

<div class="container-fluid">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Centro de Reportes Institucionales
            </h2>

            <p class="text-muted">
                Reportería ejecutiva y exportaciones institucionales
            </p>

        </div>

        <div class="d-flex gap-2">

            <a class="btn btn-outline-primary" href="/api/reportes/inventario/excel">

                <i class="bi bi-file-earmark-excel"></i>
                Exportar Excel

            </a>

            <a class="btn btn-outline-danger" href="/api/reportes/inventario/pdf">

                <i class="bi bi-file-earmark-pdf"></i>
                Exportar PDF

            </a>

        </div>

    </div>

    <!-- REPORT CARDS -->

    <div class="row g-4">

        <div class="col-lg-4">

            <div class="report-card">

                <div class="report-icon blue">

                    <i class="bi bi-box-seam-fill"></i>

                </div>

                <h5>
                    Inventario General
                </h5>

                <p class="text-muted">
                    Reporte completo de bienes institucionales
                </p>

                <a class="btn btn-primary w-100" href="/api/reportes/inventario/excel">

                    Generar Reporte

                </a>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="report-card">

                <div class="report-icon green">

                    <i class="bi bi-person-check-fill"></i>

                </div>

                <h5>
                    Bienes por Responsable
                </h5>

                <p class="text-muted">
                    Control patrimonial por usuario responsable
                </p>

                <a class="btn btn-success w-100" href="/api/reportes/inventario/excel?responsible=">

                    Generar Reporte

                </a>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="report-card">

                <div class="report-icon orange">

                    <i class="bi bi-tools"></i>

                </div>

                <h5>
                    Bienes en Reparación
                </h5>

                <p class="text-muted">
                    Activos dañados o en mantenimiento
                </p>

                <a class="btn btn-warning w-100 text-white" href="/api/reportes/inventario/pdf?status=En%20reparación">

                    Generar Reporte

                </a>

            </div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const responsibleButton = document.querySelector('a[href^="/api/reportes/inventario/excel?responsible="]');
            responsibleButton?.addEventListener('click', event => {
                event.preventDefault();
                Swal.fire({
                    title: 'Bienes por responsable',
                    input: 'text',
                    inputLabel: 'Nombre del responsable',
                    showCancelButton: true,
                    confirmButtonText: 'Generar'
                }).then(result => {
                    if (!result.isConfirmed) return;
                    const responsible = encodeURIComponent((result.value || '').trim());
                    window.location.href = `/api/reportes/inventario/excel?responsible=${responsible}`;
                });
            });
        });
    </script>
}

        </div>

    </div>

    <!-- TABLA -->

    <div class="card-custom mt-4">

        <div class="card-header-custom">

            Historial de Reportes Generados

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Reporte</th>
                        <th>Usuario</th>
                        <th>Formato</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Descargar</th>

                    </tr>

                </thead>

                <tbody>

                    <tr><td colspan="6" class="text-center text-muted py-4">Sin historial de generación en esta sesión.</td></tr>

                </tbody>

            </table>

        </div>

    </div>

</div>