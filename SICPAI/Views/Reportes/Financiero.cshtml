@{
    ViewData["Title"] = "Panel Financiero";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Panel Financiero Institucional
            </h2>

            <p class="text-muted">
                Análisis económico y patrimonial
            </p>

        </div>

        <button class="btn btn-primary">

            Exportar Consolidado

        </button>

    </div>

    <!-- KPIS -->

    <div class="row g-4 mb-4">

        <div class="col-lg-3">

            <div class="financial-card">

                <small>Valor Patrimonial</small>

                <h2 id="financialTotalValue">—</h2>

                <span class="positive">

                    +12% este año

                </span>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="financial-card">

                <small>Depreciación</small>

                <h2 id="financialDepreciation">—</h2>

                <span class="negative">

                    Actualizado

                </span>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="financial-card">

                <small>Bienes Activos</small>

                <h2 id="financialActiveAssets">—</h2>

                <span class="positive">

                    Operativos

                </span>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="financial-card">

                <small>En Reparación</small>

                <h2 id="financialInRepairAssets">—</h2>

                <span class="warning">

                    Seguimiento

                </span>

            </div>

        </div>

    </div>

    <!-- GRAFICAS -->

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card-custom">

                <div class="card-header-custom">

                    Evolución Patrimonial

                </div>

                <div class="p-4">

                    <canvas id="chartPatrimonio"
                            height="120"></canvas>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card-custom">

                <div class="card-header-custom">

                    Distribución de Bienes

                </div>

                <div class="p-4">

                    <canvas id="chartDistribucion"></canvas>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        (() => {
            const normalizeStatus = value => (value || '').toString().toLowerCase();
            const yearsBetween = (fromDate, toDate) => {
                const msPerYear = 1000 * 60 * 60 * 24 * 365.25;
                return Math.max(0, (toDate.getTime() - fromDate.getTime()) / msPerYear);
            };
            const depreciationRateByType = @Html.Raw((string?)ViewData["DepreciationRatesJson"] ?? "{}");
            const resolveAnnualRate = assetType => {
                const normalizedType = (assetType || '').toString().toLowerCase();
                for (const [key, rate] of Object.entries(depreciationRateByType)) {
                    if (normalizedType.includes(key)) return rate;
                }
                return 0.10;
            };

            const init = async () => {
                const [assetsResponse, movementsResponse] = await Promise.all([
                    fetch('/api/assets'),
                    fetch('/api/assets/movements?page=1&pageSize=1000')
                ]);

                if (!assetsResponse.ok || !movementsResponse.ok) return;

                const assets = await assetsResponse.json();
                const movementResult = await movementsResponse.json();
                const movements = Array.isArray(movementResult?.items) ? movementResult.items : [];

                const safeAssets = Array.isArray(assets) ? assets : [];
                const totalValue = safeAssets.reduce((sum, item) => sum + Number(item.acquisitionValue || 0), 0);
                const activeAssets = safeAssets.filter(item => normalizeStatus(item.status) === 'activo').length;
                const inRepairAssets = safeAssets.filter(item => normalizeStatus(item.status).includes('repar')).length;
                const now = new Date();
                const depreciation = safeAssets.reduce((sum, item) => {
                    const acquisitionValue = Number(item.acquisitionValue || 0);
                    if (acquisitionValue <= 0 || !item.acquisitionDate) return sum;

                    const acquisitionDate = new Date(item.acquisitionDate);
                    if (Number.isNaN(acquisitionDate.getTime())) return sum;

                    const usedYears = yearsBetween(acquisitionDate, now);
                    const annualRate = resolveAnnualRate(item.assetType);
                    const depreciated = Math.min(acquisitionValue, acquisitionValue * annualRate * usedYears);
                    return sum + depreciated;
                }, 0);

                document.getElementById('financialTotalValue').textContent = totalValue.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                document.getElementById('financialDepreciation').textContent = depreciation.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                document.getElementById('financialActiveAssets').textContent = activeAssets.toLocaleString('es-MX');
                document.getElementById('financialInRepairAssets').textContent = inRepairAssets.toLocaleString('es-MX');

                const monthLabels = [];
                const monthValues = [];

                for (let i = 5; i >= 0; i--) {
                    const monthDate = new Date(now.getFullYear(), now.getMonth() - i, 1);
                    const monthKey = `${monthDate.getFullYear()}-${monthDate.getMonth()}`;
                    const label = monthDate.toLocaleDateString('es-MX', { month: 'short' });
                    monthLabels.push(label.charAt(0).toUpperCase() + label.slice(1));

                    const monthMovementCount = movements.filter(movement => {
                        const occurred = movement?.occurredAt ? new Date(movement.occurredAt) : null;
                        if (!occurred || Number.isNaN(occurred.getTime())) return false;
                        return `${occurred.getFullYear()}-${occurred.getMonth()}` === monthKey;
                    }).length;

                    monthValues.push(monthMovementCount);
                }

                const typeCount = {};
                for (const asset of safeAssets) {
                    const type = (asset.assetType || 'Sin tipo').toString();
                    typeCount[type] = (typeCount[type] || 0) + 1;
                }

                const distributionLabels = Object.keys(typeCount);
                const distributionValues = distributionLabels.map(label => typeCount[label]);

                if (window.sicpaiFinancialLineChart) window.sicpaiFinancialLineChart.destroy();
                if (window.sicpaiFinancialPieChart) window.sicpaiFinancialPieChart.destroy();

                const ctx = document.getElementById('chartPatrimonio');
                if (ctx) {
                    window.sicpaiFinancialLineChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: monthLabels,
                            datasets: [{
                                label: 'Movimientos mensuales',
                                data: monthValues,
                                borderWidth: 3,
                                tension: .4
                            }]
                        }
                    });
                }

                const pie = document.getElementById('chartDistribucion');
                if (pie) {
                    window.sicpaiFinancialPieChart = new Chart(pie, {
                        type: 'doughnut',
                        data: {
                            labels: distributionLabels.length ? distributionLabels : ['Sin datos'],
                            datasets: [{
                                data: distributionValues.length ? distributionValues : [1]
                            }]
                        }
                    });
                }
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init, { once: true });
            } else {
                init();
            }
        })();

    </script>

}