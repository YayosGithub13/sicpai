@{
    ViewData["Title"] = "Analytics";
}

<div class="container-fluid">

    <div class="analytics-header mb-4">

        <div>

            <h2 class="fw-bold">
                Analytics Institucional
            </h2>

            <p class="text-muted">
                Inteligencia administrativa y operacional
            </p>

        </div>

    </div>

    <div class="analytics-grid">

        <div class="analytics-widget large">

            <div class="widget-header">

                <h5>
                    Movimientos Patrimoniales
                </h5>

            </div>

            <canvas id="movimientosChart"></canvas>

        </div>

        <div class="analytics-widget">

            <div class="widget-header">

                <h5>
                    Auditorías
                </h5>

            </div>

            <div class="metric-circle" id="analyticsAuditsRate">-</div>

        </div>

        <div class="analytics-widget">

            <div class="widget-header">

                <h5>
                    Eficiencia Operativa
                </h5>

            </div>

            <div class="metric-circle green" id="analyticsEfficiencyRate">-</div>

        </div>

        <div class="analytics-widget">

            <div class="widget-header">

                <h5>
                    Incidencias
                </h5>

            </div>

            <div class="metric-circle orange" id="analyticsIncidentsCount">-</div>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        (() => {
            const init = async () => {
                const chartCanvas = document.getElementById('movimientosChart');
                if (!chartCanvas) return;

                const [assetsResponse, movementsResponse] = await Promise.all([
                    fetch('/api/assets'),
                    fetch('/api/assets/movements?page=1&pageSize=500')
                ]);

                if (!assetsResponse.ok || !movementsResponse.ok) return;

                const assets = await assetsResponse.json();
                const movementResult = await movementsResponse.json();
                const movements = Array.isArray(movementResult?.items) ? movementResult.items : [];

                const counts = { altas: 0, bajas: 0, transferencias: 0, auditorias: 0 };
                for (const movement of movements) {
                    const type = (movement.movementType || '').toString().toLowerCase();
                    if (type.includes('alta')) counts.altas += 1;
                    else if (type.includes('baja')) counts.bajas += 1;
                    else if (type.includes('transfer')) counts.transferencias += 1;
                    else if (type.includes('audit')) counts.auditorias += 1;
                }

                if (window.sicpaiMovementsChart) {
                    window.sicpaiMovementsChart.destroy();
                }

                window.sicpaiMovementsChart = new Chart(chartCanvas, {
                    type: 'bar',
                    data: {
                        labels: ['Altas', 'Bajas', 'Transferencias', 'Auditorías'],
                        datasets: [{
                            label: 'Operaciones',
                            data: [counts.altas, counts.bajas, counts.transferencias, counts.auditorias],
                            borderWidth: 1
                        }]
                    },
                    options: { maintainAspectRatio: false }
                });

                const totalAssets = Array.isArray(assets) ? assets.length : 0;
                const activeAssets = Array.isArray(assets) ? assets.filter(a => (a.status || '').toString().toLowerCase() === 'activo').length : 0;
                const incidents = Array.isArray(assets) ? assets.filter(a => (a.status || '').toString().toLowerCase().includes('repar') || (a.status || '').toString().toLowerCase().includes('baja')).length : 0;
                const efficiency = totalAssets > 0 ? Math.round((activeAssets / totalAssets) * 100) : 0;

                const totalMovements = Math.max(1, movements.length);
                const auditsRate = Math.round((counts.auditorias / totalMovements) * 100);
                document.getElementById('analyticsAuditsRate').textContent = `${auditsRate}%`;
                document.getElementById('analyticsEfficiencyRate').textContent = `${efficiency}%`;
                document.getElementById('analyticsIncidentsCount').textContent = incidents.toString();
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init, { once: true });
            } else {
                init();
            }
        })();
    </script>

}
