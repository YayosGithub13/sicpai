@{
    ViewData["Title"] = "Historial de movimientos";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Historial de movimientos</h2>
            <p class="text-muted mb-0">Trazabilidad completa de altas, bajas, transferencias y mantenimiento</p>
        </div>
        <button class="btn btn-outline-primary"><i class="bi bi-download me-2"></i>Exportar bitácora</button>
    </div>

    <div class="card-custom mb-4">
        <div class="card-header-custom"><i class="bi bi-funnel me-2"></i>Filtros de consulta</div>
        <div class="p-4">
            <div class="row g-3 align-items-end">
                <div class="col-lg-3"><label class="form-label">Código o activo</label><input class="form-control" placeholder="EQ-000125" /></div>
                <div class="col-lg-2"><label class="form-label">Tipo de movimiento</label><select class="form-select"><option>Todos</option><option>Alta</option><option>Transferencia</option><option>Mantenimiento</option><option>Baja</option></select></div>
                <div class="col-lg-2"><label class="form-label">Usuario</label><select class="form-select"><option>Todos</option><option>Admin System</option><option>Juan Pérez</option><option>María López</option></select></div>
                <div class="col-lg-2"><label class="form-label">Desde</label><input type="date" class="form-control" /></div>
                <div class="col-lg-2"><label class="form-label">Hasta</label><input type="date" class="form-control" /></div>
                <div class="col-lg-1"><button class="btn btn-primary w-100" title="Buscar"><i class="bi bi-search"></i></button></div>
            </div>
        </div>
    </div>

    <div class="card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center"><span>Eventos registrados</span><span class="badge bg-light text-primary">12,458 eventos</span></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Fecha y hora</th><th>Activo</th><th>Movimiento</th><th>Origen / destino</th><th>Usuario</th><th>Resultado</th><th></th></tr></thead>
                <tbody>
                    <tr><td>27/05/2026 10:42</td><td><strong>EQ-00125</strong><br /><small class="text-muted">Laptop Dell Latitude</small></td><td><span class="badge bg-primary-subtle text-primary">Transferencia</span></td><td>Finanzas <i class="bi bi-arrow-right mx-1"></i> TI</td><td>Juan Pérez</td><td><span class="badge bg-success">Completado</span></td><td><button class="btn btn-sm btn-light"><i class="bi bi-eye"></i></button></td></tr>
                    <tr><td>27/05/2026 09:18</td><td><strong>EQ-00452</strong><br /><small class="text-muted">Impresora HP LaserJet</small></td><td><span class="badge bg-warning-subtle text-warning-emphasis">Mantenimiento</span></td><td>—</td><td>María López</td><td><span class="badge bg-warning text-dark">Pendiente</span></td><td><button class="btn btn-sm btn-light"><i class="bi bi-eye"></i></button></td></tr>
                    <tr><td>26/05/2026 16:05</td><td><strong>MO-00891</strong><br /><small class="text-muted">Escritorio ejecutivo</small></td><td><span class="badge bg-success-subtle text-success">Alta</span></td><td>Almacén <i class="bi bi-arrow-right mx-1"></i> Dirección</td><td>Admin System</td><td><span class="badge bg-success">Completado</span></td><td><button class="btn btn-sm btn-light"><i class="bi bi-eye"></i></button></td></tr>
                </tbody>
            </table>
        </div>
        <div class="p-3 border-top d-flex justify-content-between align-items-center"><small class="text-muted">Mostrando 1 a 3 de 12,458 resultados</small><nav><ul class="pagination pagination-sm mb-0"><li class="page-item disabled"><a class="page-link">Anterior</a></li><li class="page-item active"><a class="page-link">1</a></li><li class="page-item"><a class="page-link">2</a></li><li class="page-item"><a class="page-link">Siguiente</a></li></ul></nav></div>
    </div>
</div>
