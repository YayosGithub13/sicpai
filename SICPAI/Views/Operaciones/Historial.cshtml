@{
    ViewData["Title"] = "Historial de movimientos";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Historial de movimientos</h2>
            <p class="text-muted mb-0">Trazabilidad completa de altas, bajas, transferencias y mantenimiento</p>
        </div>
        <button class="btn btn-outline-primary"><i class="bi bi-download me-2"></i>Exportar bitácora</button>
    </div>

    <div class="card-custom mb-4">
        <div class="card-header-custom"><i class="bi bi-funnel me-2"></i>Filtros de consulta</div>
        <div class="p-4">
            <div class="row g-3 align-items-end">
                <div class="col-lg-3"><label class="form-label">Código o activo</label><input id="movementSearch" class="form-control" placeholder="Buscar por código o nombre" /></div>
                <div class="col-lg-2"><label class="form-label">Tipo de movimiento</label><select id="movementType" class="form-select"><option>Todos</option><option>Alta</option><option>Transferencia</option><option>Mantenimiento</option><option>Baja</option></select></div>
                <div class="col-lg-2"><label class="form-label">Usuario</label><select class="form-select" disabled><option>Todos</option></select></div>
                <div class="col-lg-2"><label class="form-label">Desde</label><input id="movementFrom" type="date" class="form-control" /></div>
                <div class="col-lg-2"><label class="form-label">Hasta</label><input id="movementTo" type="date" class="form-control" /></div>
                <div class="col-lg-1"><button id="searchMovements" class="btn btn-primary w-100" type="button" title="Buscar"><i class="bi bi-search"></i></button></div>
            </div>
        </div>
    </div>

    <div class="card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center"><span>Eventos registrados</span><span id="movementTotal" class="badge bg-light text-primary">0 eventos</span></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Fecha y hora</th><th>Activo</th><th>Movimiento</th><th>Origen / destino</th><th>Usuario</th><th>Resultado</th><th></th></tr></thead>
                <tbody id="movementRows"><tr><td colspan="7" class="text-center text-muted py-4">Cargando movimientos...</td></tr></tbody>
            </table>
        </div>

@section Scripts {
    <script>
        (() => {
            const rows = document.getElementById('movementRows');
            const total = document.getElementById('movementTotal');
            const escapeHtml = value => { const div = document.createElement('div'); div.textContent = value ?? ''; return div.innerHTML; };
            const load = async () => {
                const params = new URLSearchParams();
                const search = document.getElementById('movementSearch').value.trim();
                const type = document.getElementById('movementType').value;
                const from = document.getElementById('movementFrom').value;
                const to = document.getElementById('movementTo').value;
                if (search) params.set('search', search);
                if (type !== 'Todos') params.set('type', type);
                if (from) params.set('from', from);
                if (to) params.set('to', to);
                const response = await fetch(`/api/assets/movements?${params}`);
                if (!response.ok) return;
                const data = await response.json();
                total.textContent = `${data.total.toLocaleString('es-MX')} eventos`;
                rows.innerHTML = data.items.length ? data.items.map(item => `<tr><td>${new Date(item.occurredAt).toLocaleString('es-MX')}</td><td><strong>${escapeHtml(item.asset.assetCode)}</strong><br><small class="text-muted">${escapeHtml(item.asset.name)}</small></td><td><span class="badge bg-primary-subtle text-primary">${escapeHtml(item.movementType)}</span></td><td>${escapeHtml(item.fromArea || '-')} <i class="bi bi-arrow-right mx-1"></i> ${escapeHtml(item.toArea || '-')}</td><td>${escapeHtml(item.user?.fullName || '-')}</td><td><span class="badge bg-success">Registrado</span></td><td><a class="btn btn-sm btn-light" href="/Patrimonio/Detail?id=${item.asset.assetId}"><i class="bi bi-eye"></i></a></td></tr>`).join('') : '<tr><td colspan="7" class="text-center text-muted py-4">No hay movimientos para los filtros seleccionados.</td></tr>';
            };
            document.getElementById('searchMovements').addEventListener('click', load);
            document.getElementById('movementSearch').addEventListener('keydown', event => { if (event.key === 'Enter') load(); });
            load();
        })();
    </script>
}
        <div class="p-3 border-top d-flex justify-content-between align-items-center"><small id="movementSummary" class="text-muted">Sin movimientos cargados</small></div>
    </div>
</div>
