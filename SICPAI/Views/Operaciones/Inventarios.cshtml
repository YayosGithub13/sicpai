@{ ViewData["Title"] = "Inventarios físicos"; }
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h2 class="fw-bold">Inventarios físicos</h2><p class="text-muted">Conteo y conciliación institucional de bienes</p></div><button id="newInventory" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>Nuevo inventario</button></div>
    <div class="card-custom"><div class="card-header-custom">Sesiones de inventario</div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Nombre</th><th>Estado</th><th>Inicio</th><th>Acciones</th></tr></thead><tbody id="inventoryRows"><tr><td colspan="4" class="text-center text-muted">Cargando...</td></tr></tbody></table></div></div>
</div>
@section Scripts { <script>
(async function(){ const rows=document.getElementById('inventoryRows'); const response=await fetch('/api/inventarios'); if(!response.ok)return; const items=await response.json(); rows.innerHTML=items.map(x=>`<tr><td>${safe(x.name)}</td><td><span class="badge ${x.status==='Abierto'?'bg-success':'bg-secondary'}">${safe(x.status)}</span></td><td>${new Date(x.startedAt).toLocaleString('es-MX')}</td><td><a class="btn btn-sm btn-primary" href="/Operaciones/Inventarios?id=${x.id}">Abrir</a></td></tr>`).join('')||'<tr><td colspan="4" class="text-center">No hay inventarios.</td></tr>'; document.getElementById('newInventory').onclick=async()=>{const result=await Swal.fire({title:'Nuevo inventario',input:'text',inputLabel:'Nombre',showCancelButton:true,confirmButtonText:'Crear'});if(result.isConfirmed){const saved=await fetch('/api/inventarios',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:result.value})});if(saved.ok)location.reload();}};})(); function safe(v){const d=document.createElement('div');d.textContent=v??'';return d.innerHTML;}
</script> }
