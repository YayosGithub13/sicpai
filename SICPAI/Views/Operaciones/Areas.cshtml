@{
    ViewData["Title"] = "Áreas y Departamentos";
}

<div class="container-fluid">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Áreas y Departamentos
            </h2>

            <p class="text-muted mb-0">
                Administración organizacional institucional
            </p>

        </div>

@section Scripts {
    <script>
        (() => {
            const state = { areas: [] };
            const escapeHtml = value => { const div = document.createElement('div'); div.textContent = value ?? ''; return div.innerHTML; };

            const getFilters = () => ({
                search: (document.getElementById('areaSearchInput')?.value || '').trim().toLowerCase(),
                status: document.getElementById('areaStatusFilter')?.value || ''
            });

            const renderKpis = areas => {
                document.getElementById('areasTotalKpi').textContent = areas.length.toLocaleString('es-MX');
                document.getElementById('areasActiveKpi').textContent = areas.filter(area => area.active).length.toLocaleString('es-MX');
                document.getElementById('areasAssetsKpi').textContent = '-';
                document.getElementById('areasLocationsKpi').textContent = '-';
            };

            const openEditModal = areaId => {
                const area = state.areas.find(item => Number(item.id) === Number(areaId));
                if (!area) return;
                document.getElementById('areaId').value = area.id;
                document.getElementById('areaCode').value = area.code || '';
                document.getElementById('areaName').value = area.name || '';
                document.getElementById('areaDescription').value = area.description || '';
                document.getElementById('areaActive').value = area.active ? 'true' : 'false';
                document.getElementById('areaModalTitle').textContent = 'Editar Área Institucional';
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalArea')).show();
            };

            const resetModal = () => {
                document.getElementById('areaId').value = '';
                document.getElementById('areaCode').value = '';
                document.getElementById('areaName').value = '';
                document.getElementById('areaDescription').value = '';
                document.getElementById('areaActive').value = 'true';
                document.getElementById('areaModalTitle').textContent = 'Nueva Área Institucional';
            };

            const renderAreas = async () => {
                const body = document.getElementById('areasRows');
                if (!body) return;

                const response = await fetch('/api/catalogos/areas');
                if (!response.ok) return;

                state.areas = await response.json();
                const filters = getFilters();
                const filtered = state.areas.filter(area => {
                    const matchesSearch = !filters.search || (area.name || '').toLowerCase().includes(filters.search) || (area.code || '').toLowerCase().includes(filters.search);
                    const matchesStatus = !filters.status || String(area.active) === filters.status;
                    return matchesSearch && matchesStatus;
                });

                body.innerHTML = filtered.length
                    ? filtered.map(area => `<tr><td><div class="area-inline"><div class="area-icon"><i class="bi bi-diagram-3-fill"></i></div><div><div class="fw-semibold">${escapeHtml(area.name)}</div><small class="text-muted">${escapeHtml(area.code)}</small></div></div></td><td>-</td><td>-</td><td>-</td><td><span class="badge ${area.active ? 'bg-success' : 'bg-secondary'}">${area.active ? 'Activa' : 'Inactiva'}</span></td><td><button class="btn btn-sm btn-light" type="button" title="Editar" data-action="edit" data-id="${area.id}"><i class="bi bi-pencil"></i></button></td></tr>`).join('')
                    : '<tr><td colspan="6" class="text-center text-muted py-4">No hay áreas registradas.</td></tr>';

                renderKpis(state.areas);
            };

            const bindCreateArea = () => {
                const saveButton = document.getElementById('saveAreaButton');
                if (!saveButton) return;

                saveButton.addEventListener('click', async () => {
                    const areaId = Number(document.getElementById('areaId')?.value || 0);
                    const payload = {
                        code: document.getElementById('areaCode')?.value?.trim() ?? '',
                        name: document.getElementById('areaName')?.value?.trim() ?? '',
                        description: document.getElementById('areaDescription')?.value?.trim() ?? '',
                        active: (document.getElementById('areaActive')?.value ?? 'true') === 'true'
                    };

                    if (!payload.code || !payload.name) {
                        Swal.fire('Datos incompletos', 'Código y nombre son obligatorios.', 'warning');
                        return;
                    }

                    saveButton.setAttribute('disabled', 'disabled');
                    try {
                        const saved = await fetch(areaId > 0 ? `/api/catalogos/areas/${areaId}` : '/api/catalogos/areas', {
                            method: areaId > 0 ? 'PUT' : 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });

                        if (!saved.ok) {
                            const error = await saved.json().catch(() => null);
                            Swal.fire('Error', error?.error || 'No se pudo guardar el área.', 'error');
                            return;
                        }

                        const modalElement = document.getElementById('modalArea');
                        const modal = modalElement ? bootstrap.Modal.getOrCreateInstance(modalElement) : null;
                        modal?.hide();
                        resetModal();
                        Swal.fire('Guardada', areaId > 0 ? 'Área actualizada correctamente.' : 'Área creada correctamente.', 'success');
                        await renderAreas();
                    } finally {
                        saveButton.removeAttribute('disabled');
                    }
                });
            };

            const bindFilters = () => {
                document.getElementById('areaSearchInput')?.addEventListener('input', renderAreas);
                document.getElementById('areaStatusFilter')?.addEventListener('change', renderAreas);
            };

            const bindActions = () => {
                document.getElementById('areasRows')?.addEventListener('click', event => {
                    const button = event.target.closest('button[data-action="edit"]');
                    if (!button) return;
                    openEditModal(button.dataset.id);
                });

                document.getElementById('exportAreasCsv')?.addEventListener('click', () => {
                    const lines = ['Codigo,Nombre,Descripcion,Estado'];
                    for (const area of state.areas) {
                        lines.push(`"${(area.code || '').replaceAll('"', '""')}","${(area.name || '').replaceAll('"', '""')}","${(area.description || '').replaceAll('"', '""')}","${area.active ? 'Activa' : 'Inactiva'}"`);
                    }
                    const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
                    const url = URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = `areas-${new Date().toISOString().slice(0, 10)}.csv`;
                    link.click();
                    URL.revokeObjectURL(url);
                });

                document.getElementById('exportAreasPdf')?.addEventListener('click', () => window.print());
                document.getElementById('exportAreasTopButton')?.addEventListener('click', () => document.getElementById('exportAreasCsv')?.click());
                document.getElementById('openAreaModal')?.addEventListener('click', resetModal);
                document.getElementById('modalArea')?.addEventListener('hidden.bs.modal', resetModal);
            };

            const init = async () => {
                bindFilters();
                bindActions();
                await renderAreas();
                bindCreateArea();
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init, { once: true });
            } else {
                init();
            }
        })();
    </script>
}

        <div class="d-flex gap-2">

            <button class="btn btn-light" id="exportAreasTopButton" type="button">

                <i class="bi bi-download"></i>
                Exportar

            </button>

            <button class="btn btn-primary"
                    id="openAreaModal"
                    data-bs-toggle="modal"
                    data-bs-target="#modalArea">

                <i class="bi bi-plus-circle"></i>
                Nueva Área

            </button>

        </div>

    </div>

    <!-- KPIS -->

    <div class="row g-4 mb-4">

        <div class="col-lg-3">

            <div class="kpi-card">

                <div>

                    <h6>Total Áreas</h6>

                <h2 id="areasTotalKpi">0</h2>

                    <span class="success-text">
                        Institucionales
                    </span>

                </div>

                <div class="kpi-icon blue">

                    <i class="bi bi-diagram-3-fill"></i>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="kpi-card">

                <div>

                    <h6>Responsables</h6>

                    <h2 id="areasActiveKpi">0</h2>

                    <span class="success-text">
                        Activos
                    </span>

                </div>

                <div class="kpi-icon green">

                    <i class="bi bi-people-fill"></i>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="kpi-card">

                <div>

                    <h6>Bienes Asignados</h6>

                    <h2 id="areasAssetsKpi">—</h2>

                    <span class="warning-text">
                        Inventario total
                    </span>

                </div>

                <div class="kpi-icon orange">

                    <i class="bi bi-pc-display"></i>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="kpi-card">

                <div>

                    <h6>Ubicaciones</h6>

                    <h2 id="areasLocationsKpi">—</h2>

                    <span class="danger-text">
                        Registradas
                    </span>

                </div>

                <div class="kpi-icon red">

                    <i class="bi bi-geo-alt-fill"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- FILTROS -->

    <div class="card-custom mb-4">

        <div class="card-header-custom">

            Filtros Organizacionales

        </div>

        <div class="p-4">

            <div class="row g-3">

                <div class="col-lg-4">

                    <label class="form-label">
                        Buscar Área
                    </label>

                    <input type="text"
                           id="areaSearchInput"
                           class="form-control"
                           placeholder="Nombre del área">

                </div>

                <div class="col-lg-4">

                    <label class="form-label">
                        Responsable
                    </label>

                    <select class="form-select" disabled>

                        <option>Todos</option>

                    </select>

                </div>

                <div class="col-lg-4">

                    <label class="form-label">
                        Estado
                    </label>

                    <select class="form-select" id="areaStatusFilter">

                        <option value="">Todas</option>
                        <option value="true">Activa</option>
                        <option value="false">Inactiva</option>

                    </select>

                </div>

            </div>

        </div>

    </div>

    <!-- TABLA -->

    <div class="card-custom">

        <div class="card-header-custom d-flex justify-content-between align-items-center">

            <span>
                Estructura Organizacional
            </span>

            <div class="d-flex gap-2">

                <button class="btn btn-sm btn-outline-primary" id="exportAreasCsv" type="button">

                    Excel

                </button>

                <button class="btn btn-sm btn-outline-danger" id="exportAreasPdf" type="button">

                    PDF

                </button>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Área</th>
                        <th>Responsable</th>
                        <th>Ubicación</th>
                        <th>Bienes</th>
                        <th>Estado</th>
                        <th>Acciones</th>

                    </tr>

                </thead>

                <tbody id="areasRows">
                    <tr><td colspan="6" class="text-center text-muted py-4">Cargando áreas...</td></tr>
                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- MODAL NUEVA ÁREA -->

<div class="modal fade"
     id="modalArea"
     tabindex="-1">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow-lg">

            <div class="modal-header">

                <h5 class="modal-title">

                    <span id="areaModalTitle">Nueva Área Institucional</span>

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body p-4">

                <div class="row g-4">

                    <div class="col-lg-6">

                        <label class="form-label">
                            Nombre del Área
                        </label>

                        <input type="text"
                               id="areaName"
                               class="form-control"
                               placeholder="Ingrese nombre">

                    </div>

                    <div class="col-lg-6">

                        <label class="form-label">
                            Responsable
                        </label>

                        <select class="form-select" disabled>

                            <option>Seleccione</option>

                        </select>

                    </div>

                    <div class="col-lg-6">

                        <label class="form-label">
                            Ubicación
                        </label>

                        <input type="hidden" id="areaId">
                        <input type="text"
                               id="areaCode"
                               class="form-control"
                               placeholder="Código institucional">

                    </div>

                    <div class="col-lg-6">

                        <label class="form-label">
                            Estado
                        </label>

                        <select class="form-select" id="areaActive">

                            <option value="true">Activa</option>
                            <option value="false">Inactiva</option>

                        </select>

                    </div>

                    <div class="col-lg-12">

                        <label class="form-label">
                            Descripción
                        </label>

                        <textarea id="areaDescription"
                                  class="form-control"
                                  rows="4"></textarea>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-light"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

                <button class="btn btn-primary" id="saveAreaButton" type="button">

                    Guardar Área

                </button>

            </div>

        </div>

    </div>

</div>