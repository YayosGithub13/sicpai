@{
    ViewData["Title"] = "Responsables";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Responsables Institucionales
            </h2>

            <p class="text-muted">
                Administración de responsables patrimoniales y control de resguardo
            </p>

        </div>

        <button class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#modalResponsable">
            <i class="bi bi-person-plus-fill"></i>
            Nuevo Responsable
        </button>

    </div>

    <div class="card-custom">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Responsable</th>
                        <th>Encargado de Resguardo</th>
                        <th>Área</th>
                        <th>Cargo</th>
                        <th>Activos</th>
                        <th>Valor UMA</th>
                        <th>Clasificación</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>

                </thead>

                <tbody id="responsablesRows">
                    <tr><td colspan="9" class="text-center text-muted py-4">Cargando responsables...</td></tr>
                </tbody>

            </table>

        </div>

    </div>

</div>

<div class="modal fade" id="modalResponsable" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Nuevo Responsable Institucional</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="row g-3">

                    <!-- Responsable -->
                    <div class="col-md-6">
                        <label class="form-label">Responsable</label>
                        <input type="hidden" id="responsableId">
                        <input type="text" class="form-control" id="responsableNombre">
                    </div>

                    <!-- Encargado resguardo -->
                    <div class="col-md-6">
                        <label class="form-label">Encargado de Resguardo</label>
                        <input type="text" class="form-control" id="resguardoNombre">
                    </div>

                    <!-- Área -->
                    <div class="col-md-6">
                        <label class="form-label">Área</label>
                        <select class="form-select" id="area">
                            <option value="">Seleccionar área</option>
                        </select>
                    </div>

                    <!-- Cargo -->
                    <div class="col-md-6">
                        <label class="form-label">Cargo</label>
                        <input type="text" class="form-control" id="cargo">
                    </div>

                    <!-- Tipo de registro (CLAVE para tu regla 70 UMAS) -->
                    <div class="col-md-12">
                        <label class="form-label">Clasificación del Responsable</label>
                        <select class="form-select" id="clasificacion">
                            <option value="activo">
                                Bien Patrimonial (Activo > 70 UMAS)
                            </option>
                            <option value="gasto">
                                Gasto (≤ 70 UMAS)
                            </option>
                        </select>

                        <small class="text-muted">
                            Si el valor del bien es menor o igual a 70 UMAS se registra como gasto.
                            Si es mayor, se clasifica como activo.
                        </small>
                    </div>

                    <!-- Contacto -->
                    <div class="col-md-6">
                        <label class="form-label">Correo</label>
                        <input type="email" class="form-control" id="correo">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Teléfono</label>
                        <input type="text" class="form-control" id="telefono">
                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-light" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button class="btn btn-primary" onclick="guardarResponsable()">
                    Guardar
                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts{
    <script>
        (() => {
            let responsables = [];
            const rows = document.getElementById('responsablesRows');
            const areaSelect = document.getElementById('area');
            const modalElement = document.getElementById('modalResponsable');
            const modalTitle = modalElement?.querySelector('.modal-title');
            const escapeHtml = value => { const div = document.createElement('div'); div.textContent = value ?? ''; return div.innerHTML; };
            const initials = name => (name || '?').split(' ').filter(Boolean).slice(0, 2).map(part => part[0]).join('').toUpperCase();

            const resetForm = () => {
                document.getElementById('responsableId').value = '';
                document.getElementById('responsableNombre').value = '';
                document.getElementById('resguardoNombre').value = '';
                document.getElementById('area').value = '';
                document.getElementById('cargo').value = '';
                document.getElementById('clasificacion').value = 'activo';
                document.getElementById('correo').value = '';
                document.getElementById('telefono').value = '';
                if (modalTitle) modalTitle.textContent = 'Nuevo Responsable Institucional';
            };

            const renderRows = () => {
                if (!rows) return;
                rows.innerHTML = responsables.length
                    ? responsables.map(user => `<tr><td><div class="user-inline"><div class="user-avatar">${escapeHtml(initials(user.fullName))}</div><div><div class="fw-semibold">${escapeHtml(user.fullName)}</div><small class="text-muted">${escapeHtml(user.email)}</small></div></div></td><td>-</td><td>-</td><td>${escapeHtml(user.roles?.join(', ') || 'Responsable patrimonial')}</td><td>${Number(user.assetCount || 0).toLocaleString('es-MX')}</td><td>-</td><td><span class="badge bg-success-subtle text-success">${user.assetCount > 0 ? 'Con bienes asignados' : 'Sin bienes asignados'}</span></td><td><span class="badge ${user.activeFlag ? 'bg-success' : 'bg-secondary'}">${user.activeFlag ? 'Activo' : 'Inactivo'}</span></td><td><button class="btn btn-sm btn-light" type="button" title="Editar" data-action="edit" data-id="${user.id}"><i class="bi bi-pencil"></i></button></td></tr>`).join('')
                    : '<tr><td colspan="9" class="text-center text-muted py-4">No hay responsables registrados.</td></tr>';
            };

            const loadResponsables = async () => {
                const response = await fetch('/api/catalogos/responsables');
                if (!response.ok) return;
                responsables = await response.json();
                renderRows();
            };

            const loadAreas = async () => {
                if (!areaSelect) return;
                const areaResponse = await fetch('/api/catalogos/areas');
                if (!areaResponse.ok) return;
                const areas = await areaResponse.json();
                areaSelect.innerHTML = '<option value="">Seleccionar área</option>' + areas.map(area => `<option value="${escapeHtml(area.code)}">${escapeHtml(area.name)}</option>`).join('');
            };

            const editResponsable = id => {
                const responsable = responsables.find(item => Number(item.id) === Number(id));
                if (!responsable) return;
                document.getElementById('responsableId').value = responsable.id;
                document.getElementById('responsableNombre').value = responsable.fullName || '';
                document.getElementById('correo').value = responsable.email || '';
                if (modalTitle) modalTitle.textContent = 'Editar Responsable Institucional';
                const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.show();
            };

            window.guardarResponsable = async () => {
                const responsableId = Number(document.getElementById('responsableId').value || 0);
                const fullName = document.getElementById('responsableNombre').value.trim();
                const email = document.getElementById('correo').value.trim();

                if (!fullName || !email) {
                    Swal.fire('Datos incompletos', 'Nombre y correo son obligatorios.', 'warning');
                    return;
                }

                const userName = email.includes('@@') ? email.split('@@')[0] : fullName.toLowerCase().replace(/\s+/g, '.');
                const payload = { fullName, userName, email, active: true };
                const url = responsableId > 0 ? `/api/catalogos/responsables/${responsableId}` : '/api/catalogos/responsables';
                const method = responsableId > 0 ? 'PUT' : 'POST';

                const response = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json().catch(() => ({}));
                if (!response.ok) {
                    Swal.fire('Error', result.error || 'No se pudo guardar el responsable.', 'error');
                    return;
                }

                Swal.fire('Guardado', responsableId > 0 ? 'Responsable actualizado.' : 'Responsable registrado.', 'success');
                bootstrap.Modal.getOrCreateInstance(modalElement).hide();
                resetForm();
                await loadResponsables();
            };

            rows?.addEventListener('click', event => {
                const button = event.target.closest('button[data-action="edit"]');
                if (!button) return;
                editResponsable(button.dataset.id);
            });

            modalElement?.addEventListener('hidden.bs.modal', resetForm);
            document.querySelector('[data-bs-target="#modalResponsable"]')?.addEventListener('click', resetForm);

            document.addEventListener('DOMContentLoaded', async () => {
                await Promise.all([loadAreas(), loadResponsables()]);
            });
        })();
    </script>
}