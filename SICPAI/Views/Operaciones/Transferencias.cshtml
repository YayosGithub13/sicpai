@{
    ViewData["Title"] = "Transferencias";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Transferencias Internas
            </h2>

            <p class="text-muted">
                Gestión institucional de movimientos patrimoniales
            </p>

        </div>

        <button class="btn btn-primary" id="newTransferButton" type="button">

            <i class="bi bi-plus-circle"></i>
            Nueva Transferencia

        </button>

    </div>

    <div class="row g-4">

        <!-- ACTUAL -->

        <div class="col-lg-6">

            <div class="card-custom h-100">

                <div class="card-header-custom">

                    Información Actual

                </div>

                <div class="p-4">

                    <div class="input-group mb-3">
                        <input id="transferAssetCode" class="form-control" placeholder="Código patrimonial o de barras">
                        <button id="loadTransferAsset" class="btn btn-outline-primary" type="button">Consultar</button>
                    </div>

                    <div class="transfer-box">

                        <div class="transfer-icon">

                            <i class="bi bi-laptop"></i>

                        </div>

                        <div>

                            <h5 class="mb-1" id="currentAssetName">Sin activo seleccionado</h5>

                            <span class="text-muted">
                                <span id="currentAssetCode">-</span>
                            </span>

                        </div>

                    </div>

                    <hr>

                    <div class="info-list">

                        <div class="info-item">

                            <label>Área actual</label>

                            <strong id="currentAssetArea">-</strong>

                        </div>

                        <div class="info-item">

                            <label>Responsable actual</label>

                            <strong id="currentAssetResponsible">-</strong>

                        </div>

                        <div class="info-item">

                            <label>Ubicación</label>

                            <strong id="currentAssetLocation">-</strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- NUEVA -->

        <div class="col-lg-6">

            <div class="card-custom h-100">

                <div class="card-header-custom">

                    Nueva Asignación

                </div>

                <div class="p-4">

                    <div class="mb-3">

                        <label class="form-label">
                            Nueva Área
                        </label>

                        <select class="form-select" id="transferArea">

                            <option value="">Seleccionar área</option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Nuevo Responsable
                        </label>

                        <select class="form-select" id="transferResponsible">

                            <option value="">Seleccionar responsable</option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Nueva Ubicación
                        </label>

                        <select class="form-select" id="transferLocation">
                            <option value="">Seleccionar ubicación</option>
                        </select>

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Observaciones
                        </label>

                        <textarea id="transferReason" class="form-control"
                                  rows="4"></textarea>

                    </div>

                    <button class="btn btn-primary w-100" id="submitTransfer" type="button">

                        Confirmar Transferencia

                    </button>

                </div>

            </div>

<div class="card-custom mt-4">
    <div class="card-header-custom d-flex justify-content-between align-items-center">
        <span>Solicitudes de transferencia</span>
        <select id="transferStatus" class="form-select form-select-sm" style="max-width:180px">
            <option value="">Todas</option>
            <option value="Pendiente">Pendientes</option>
            <option value="Aprobada">Aprobadas</option>
            <option value="Rechazada">Rechazadas</option>
        </select>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Activo</th><th>Origen</th><th>Destino</th><th>Solicitante</th><th>Fecha</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody id="transferRows"></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            let selectedAsset = null;
            const escapeHtml = value => { const div = document.createElement('div'); div.textContent = value ?? ''; return div.innerHTML; };

            const loadCatalogs = async () => {
                const [areasResponse, responsablesResponse, ubicacionesResponse] = await Promise.all([
                    fetch('/api/catalogos/areas'),
                    fetch('/api/catalogos/responsables'),
                    fetch('/api/catalogos/ubicaciones')
                ]);

                if (areasResponse.ok) {
                    const areas = await areasResponse.json();
                    const areaSelect = document.getElementById('transferArea');
                    areaSelect.innerHTML = '<option value="">Seleccionar área</option>' + areas.map(area => `<option value="${escapeHtml(area.name)}">${escapeHtml(area.name)}</option>`).join('');
                }

                if (responsablesResponse.ok) {
                    const responsables = await responsablesResponse.json();
                    const responsableSelect = document.getElementById('transferResponsible');
                    responsableSelect.innerHTML = '<option value="">Seleccionar responsable</option>' + responsables.map(responsable => `<option value="${escapeHtml(responsable.fullName)}">${escapeHtml(responsable.fullName)}</option>`).join('');
                }

                if (ubicacionesResponse.ok) {
                    const ubicaciones = await ubicacionesResponse.json();
                    const locationSelect = document.getElementById('transferLocation');
                    locationSelect.innerHTML = '<option value="">Seleccionar ubicación</option>' + ubicaciones.map(ubicacion => `<option value="${escapeHtml(ubicacion.name || ubicacion.site)}">${escapeHtml(ubicacion.site)}${ubicacion.name ? ` - ${escapeHtml(ubicacion.name)}` : ''}</option>`).join('');
                }
            };

            const loadTransfers = async () => {
                const status = document.getElementById('transferStatus').value;
                const response = await fetch(`/api/transferencias${status ? `?status=${encodeURIComponent(status)}` : ''}`);
                if (!response.ok) return;
                const transfers = await response.json();
                document.getElementById('transferRows').innerHTML = transfers.length
                    ? transfers.map(item => `<tr>
                        <td><strong>${escapeHtml(item.asset?.assetCode)}</strong><br><small>${escapeHtml(item.asset?.name)}</small></td>
                        <td>${escapeHtml(item.fromArea || '-')}</td>
                        <td>${escapeHtml(item.toArea || '-')}</td>
                        <td>${escapeHtml(item.requestedByUser?.fullName || '-')}</td>
                        <td>${new Date(item.requestedAt).toLocaleString('es-MX')}</td>
                        <td><span class="badge ${item.status === 'Pendiente' ? 'bg-warning text-dark' : item.status === 'Aprobada' ? 'bg-success' : 'bg-secondary'}">${escapeHtml(item.status)}</span></td>
                        <td>
                            ${item.status === 'Pendiente'
                                ? `<div class="d-flex gap-2"><button class="btn btn-sm btn-success" data-action="approve" data-id="${item.id}" type="button">Aprobar</button><button class="btn btn-sm btn-outline-danger" data-action="reject" data-id="${item.id}" type="button">Rechazar</button></div>`
                                : '<span class="text-muted">Procesada</span>'}
                        </td>
                    </tr>`).join('')
                    : '<tr><td colspan="7" class="text-center text-muted py-4">No hay solicitudes de transferencia.</td></tr>';
            };

            const processTransfer = async (id, action) => {
                if (action === 'approve') {
                    const response = await fetch(`/api/transferencias/${id}/aprobar`, { method: 'PATCH' });
                    const result = await response.json().catch(() => ({}));
                    Swal.fire(response.ok ? 'Aprobada' : 'Error', response.ok ? 'La transferencia fue aprobada.' : (result.error || 'No se pudo aprobar.'), response.ok ? 'success' : 'error');
                    if (response.ok) await loadTransfers();
                    return;
                }

                const rejection = await Swal.fire({
                    title: 'Rechazar transferencia',
                    input: 'textarea',
                    inputLabel: 'Motivo del rechazo',
                    showCancelButton: true,
                    confirmButtonText: 'Rechazar'
                });
                if (!rejection.isConfirmed) return;

                const response = await fetch(`/api/transferencias/${id}/rechazar`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason: rejection.value || null })
                });
                const result = await response.json().catch(() => ({}));
                Swal.fire(response.ok ? 'Rechazada' : 'Error', response.ok ? 'La transferencia fue rechazada.' : (result.error || 'No se pudo rechazar.'), response.ok ? 'success' : 'error');
                if (response.ok) await loadTransfers();
            };

            document.getElementById('loadTransferAsset').addEventListener('click', async () => {
                const code = document.getElementById('transferAssetCode').value.trim();
                if (!code) return;
                const response = await fetch(`/api/assets/scan/${encodeURIComponent(code)}`);
                if (!response.ok) { selectedAsset = null; Swal.fire('Activo no encontrado', 'Verifique el código patrimonial o de barras.', 'warning'); return; }
                selectedAsset = await response.json();
                document.getElementById('currentAssetName').textContent = selectedAsset.name;
                document.getElementById('currentAssetCode').textContent = selectedAsset.assetCode;
                document.getElementById('currentAssetArea').textContent = selectedAsset.area || '-';
                document.getElementById('currentAssetResponsible').textContent = selectedAsset.responsible || '-';
                document.getElementById('currentAssetLocation').textContent = selectedAsset.location || '-';
            });
            document.getElementById('submitTransfer').addEventListener('click', async () => {
                if (!selectedAsset) { Swal.fire('Seleccione un activo', 'Consulte primero el bien que desea transferir.', 'warning'); return; }
                const payload = { assetId: selectedAsset.id, toArea: document.getElementById('transferArea').value, toResponsible: document.getElementById('transferResponsible').value, toLocation: document.getElementById('transferLocation').value, reason: document.getElementById('transferReason').value.trim() };
                if (!payload.toArea || !payload.reason) { Swal.fire('Datos incompletos', 'El área destino y el motivo son obligatorios.', 'warning'); return; }
                const response = await fetch('/api/transferencias', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                const result = await response.json().catch(() => ({}));
                if (!response.ok) { Swal.fire('No se pudo solicitar', result.error || 'Ocurrió un error al guardar la solicitud.', 'error'); return; }
                await Swal.fire('Solicitud registrada', 'La transferencia quedó pendiente de aprobación.', 'success');
                document.getElementById('transferReason').value = '';
                loadTransfers();
            });

            document.getElementById('transferRows').addEventListener('click', async event => {
                const button = event.target.closest('button[data-action]');
                if (!button) return;
                const id = Number(button.dataset.id);
                if (!Number.isFinite(id) || id <= 0) return;
                await processTransfer(id, button.dataset.action);
            });

            document.getElementById('newTransferButton').addEventListener('click', () => {
                document.getElementById('transferAssetCode').focus();
            });

            document.getElementById('transferStatus').addEventListener('change', loadTransfers);
            loadCatalogs();
            loadTransfers();
        })();
    </script>
}

        </div>

    </div>

</div>