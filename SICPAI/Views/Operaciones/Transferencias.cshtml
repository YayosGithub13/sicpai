@{
    ViewData["Title"] = "Transferencias";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Transferencias Internas
            </h2>

            <p class="text-muted">
                Gestión institucional de movimientos patrimoniales
            </p>

        </div>

        <button class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>
            Nueva Transferencia

        </button>

    </div>

    <div class="row g-4">

        <!-- ACTUAL -->

        <div class="col-lg-6">

            <div class="card-custom h-100">

                <div class="card-header-custom">

                    Información Actual

                </div>

                <div class="p-4">

                    <div class="transfer-box">

                        <div class="transfer-icon">

                            <i class="bi bi-laptop"></i>

                        </div>

                        <div>

                            <h5 class="mb-1">
                                Laptop Dell Latitude
                            </h5>

                            <span class="text-muted">
                                EQ-000125
                            </span>

                        </div>

                    </div>

                    <hr>

                    <div class="info-list">

                        <div class="info-item">

                            <label>Área actual</label>

                            <strong>Tecnologías</strong>

                        </div>

                        <div class="info-item">

                            <label>Responsable actual</label>

                            <strong>Juan Pérez</strong>

                        </div>

                        <div class="info-item">

                            <label>Ubicación</label>

                            <strong>Edificio A - Oficina 201</strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- NUEVA -->

        <div class="col-lg-6">

            <div class="card-custom h-100">

                <div class="card-header-custom">

                    Nueva Asignación

                </div>

                <div class="p-4">

                    <div class="mb-3">

                        <label class="form-label">
                            Nueva Área
                        </label>

                        <select class="form-select">

                            <option>Finanzas</option>
                            <option>Recursos Humanos</option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Nuevo Responsable
                        </label>

                        <select class="form-select">

                            <option>María López</option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Nueva Ubicación
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Oficina destino">

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Observaciones
                        </label>

                        <textarea class="form-control"
                                  rows="4"></textarea>

                    </div>

                    <button class="btn btn-primary w-100">

                        Confirmar Transferencia

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>