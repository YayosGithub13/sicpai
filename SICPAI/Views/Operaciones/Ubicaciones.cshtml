@{
    ViewData["Title"] = "Ubicaciones físicas";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Ubicaciones físicas</h2>
            <p class="text-muted mb-0">Sedes, edificios, pisos y espacios donde se encuentran los bienes</p>
        </div>
        <button class="btn btn-primary" id="addLocationButton" type="button">
            <i class="bi bi-plus-circle me-2"></i>Nueva ubicación
        </button>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4"><div class="kpi-card"><div><h6>Sedes registradas</h6><h2>—</h2><span class="success-text">Dinámico</span></div><div class="kpi-icon blue"><i class="bi bi-buildings"></i></div></div></div>
        <div class="col-md-4"><div class="kpi-card"><div><h6>Espacios controlados</h6><h2>—</h2><span class="success-text">Dinámico</span></div><div class="kpi-icon green"><i class="bi bi-geo-alt"></i></div></div></div>
        <div class="col-md-4"><div class="kpi-card"><div><h6>Sin inventario asignado</h6><h2>—</h2><span class="warning-text">Dinámico</span></div><div class="kpi-icon orange"><i class="bi bi-exclamation-circle"></i></div></div></div>
    </div>

    <div class="card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center"><span>Catálogo de ubicaciones</span><div class="input-group" style="max-width:280px"><span class="input-group-text"><i class="bi bi-search"></i></span><input class="form-control" placeholder="Buscar ubicación" /></div></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Clave</th>
                        <th>Sede / plantel</th>
                        <th>Edificio</th>
                        <th>Nivel</th>
                        <th>Espacio</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="locationsRows">
                    <tr><td colspan="8" class="text-center text-muted py-4">Cargando ubicaciones...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const escapeHtml = value => { const div = document.createElement('div'); div.textContent = value ?? ''; return div.innerHTML; };

            const renderLocations = async () => {
                const body = document.getElementById('locationsRows');
                if (!body) return;

                const response = await fetch('/api/catalogos/ubicaciones');
                if (!response.ok) return;

                const locations = await response.json();
                body.innerHTML = locations.length
                    ? locations.map(location => `<tr><td><strong>${escapeHtml(location.code)}</strong></td><td>${escapeHtml(location.site)}</td><td>${escapeHtml(location.building || '-')}</td><td>${escapeHtml(location.floor || '-')}</td><td>${escapeHtml(location.name || '-')}</td><td>${escapeHtml(location.description || '-')}</td><td><span class="badge ${location.active ? 'bg-success' : 'bg-secondary'}">${location.active ? 'Activa' : 'Inactiva'}</span></td><td><button class="btn btn-sm btn-light" type="button" title="Editar"><i class="bi bi-pencil"></i></button></td></tr>`).join('')
                    : '<tr><td colspan="8" class="text-center text-muted py-4">No hay ubicaciones registradas.</td></tr>';
            };

            const bindCreateLocation = () => {
                const addButton = document.getElementById('addLocationButton');
                if (!addButton) return;

                addButton.addEventListener('click', async () => {
                    const result = await Swal.fire({
                        title: 'Nueva ubicación',
                        html: '<input id="locCode" class="swal2-input" placeholder="Código"><input id="locSite" class="swal2-input" placeholder="Sede"><input id="locName" class="swal2-input" placeholder="Espacio"><input id="locBuilding" class="swal2-input" placeholder="Edificio"><input id="locFloor" class="swal2-input" placeholder="Piso"><textarea id="locDescription" class="swal2-textarea" placeholder="Descripción"></textarea>',
                        showCancelButton: true,
                        confirmButtonText: 'Guardar',
                        preConfirm: () => ({
                            code: document.getElementById('locCode').value.trim(),
                            site: document.getElementById('locSite').value.trim(),
                            name: document.getElementById('locName').value.trim(),
                            building: document.getElementById('locBuilding').value.trim(),
                            floor: document.getElementById('locFloor').value.trim(),
                            description: document.getElementById('locDescription').value.trim()
                        })
                    });

                    if (!result.isConfirmed) return;
                    if (!result.value.code || !result.value.site || !result.value.name) {
                        Swal.fire('Datos incompletos', 'Código, sede y espacio son obligatorios.', 'warning');
                        return;
                    }

                    const saved = await fetch('/api/catalogos/ubicaciones', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(result.value)
                    });

                    Swal.fire(saved.ok ? 'Guardada' : 'Error', saved.ok ? 'Ubicación creada.' : 'No se pudo crear.', saved.ok ? 'success' : 'error');
                    if (saved.ok) await renderLocations();
                });
            };

            const init = async () => {
                await renderLocations();
                bindCreateLocation();
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init, { once: true });
            } else {
                init();
            }
        })();
    </script>
}
