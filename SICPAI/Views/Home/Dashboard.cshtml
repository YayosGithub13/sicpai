@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- Breadcrumb -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Dashboard Ejecutivo
            </h2>

            <nav>

                <ol class="breadcrumb">

                    <li class="breadcrumb-item">
                        Inicio
                    </li>

                    <li class="breadcrumb-item active">
                        Dashboard
                    </li>

                </ol>

            </nav>

        </div>

        <button class="btn btn-primary">

            <i class="bi bi-download"></i>
            Exportar Reporte

        </button>

    </div>

    <!-- KPIS -->

    <div class="row g-4 mb-4">

        <div class="col-lg-3">

            <div class="kpi-card">

                <div>

                    <h6>Total de Bienes</h6>

                    <h2 id="kpiTotal">0</h2>

                    <span class="success-text">
                        +12% este mes
                    </span>

                </div>

                <div class="kpi-icon blue">

                    <i class="bi bi-pc-display"></i>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="kpi-card">

                <div>

                    <h6>Activos Operativos</h6>

                    <h2 id="kpiActive">0</h2>

                    <span class="success-text">
                        Operando correctamente
                    </span>

                </div>

                <div class="kpi-icon green">

                    <i class="bi bi-check-circle-fill"></i>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="kpi-card">

                <div>

                    <h6>En Reparación</h6>

                    <h2 id="kpiRepair">0</h2>

                    <span class="warning-text">
                        Requieren atención
                    </span>

                </div>

                <div class="kpi-icon orange">

                    <i class="bi bi-tools"></i>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="kpi-card">

                <div>

                    <h6>Extraviados</h6>

                    <h2 id="kpiMissing">0</h2>

                    <span class="danger-text">
                        Auditoría requerida
                    </span>

                </div>

@section Scripts {
    <script>
        (() => {
            const renderRecentMovements = movements => {
                const body = document.getElementById('dashboardRecentMovementsRows');
                if (!body) return;

                body.innerHTML = movements.length
                    ? movements.map(movement => {
                        const occurredAt = movement?.occurredAt ? new Date(movement.occurredAt) : null;
                        const occurredText = occurredAt && !Number.isNaN(occurredAt.getTime())
                            ? occurredAt.toLocaleString('es-MX')
                            : '-';
                        const type = movement?.movementType || '-';
                        const assetCode = movement?.asset?.assetCode || '-';
                        const assetName = movement?.asset?.name || '-';
                        const userName = movement?.user?.fullName || '-';
                        const statusBadge = type.toLowerCase().includes('baja')
                            ? 'bg-danger'
                            : type.toLowerCase().includes('transfer')
                                ? 'bg-info text-dark'
                                : type.toLowerCase().includes('manten')
                                    ? 'bg-warning text-dark'
                                    : 'bg-success';

                        return `<tr>
                            <td>${assetCode}</td>
                            <td>${assetName}</td>
                            <td>${type}</td>
                            <td>${userName}</td>
                            <td>${occurredText}</td>
                            <td><span class="badge ${statusBadge}">${type}</span></td>
                        </tr>`;
                    }).join('')
                    : '<tr><td colspan="6" class="text-center text-muted py-4">Sin movimientos recientes para mostrar.</td></tr>';
            };

            const init = async () => {
                const [summaryResponse, movementsResponse] = await Promise.all([
                    fetch('/api/dashboard/summary'),
                    fetch('/api/assets/movements?page=1&pageSize=10')
                ]);

                if (!summaryResponse.ok) return;
                const data = await summaryResponse.json();

                document.getElementById('kpiTotal').textContent = Number(data.total || 0).toLocaleString('es-MX');
                document.getElementById('kpiActive').textContent = Number(data.active || 0).toLocaleString('es-MX');
                document.getElementById('kpiRepair').textContent = Number(data.repair || 0).toLocaleString('es-MX');
                document.getElementById('kpiMissing').textContent = Number(data.missing || 0).toLocaleString('es-MX');

                if (window.Chart) {
                    const areaCanvas = document.getElementById('assetsChart');
                    const statusCanvas = document.getElementById('statusChart');

                    if (window.sicpaiDashboardAreaChart) window.sicpaiDashboardAreaChart.destroy();
                    if (window.sicpaiDashboardStatusChart) window.sicpaiDashboardStatusChart.destroy();

                    window.sicpaiDashboardAreaChart = new Chart(areaCanvas, {
                        type: 'bar',
                        data: {
                            labels: (data.byArea || []).map(x => x.area),
                            datasets: [{
                                label: 'Bienes',
                                data: (data.byArea || []).map(x => x.total),
                                backgroundColor: '#0d47a1'
                            }]
                        },
                        options: { responsive: true, maintainAspectRatio: false }
                    });

                    window.sicpaiDashboardStatusChart = new Chart(statusCanvas, {
                        type: 'doughnut',
                        data: {
                            labels: (data.byStatus || []).map(x => x.status),
                            datasets: [{
                                data: (data.byStatus || []).map(x => x.total),
                                backgroundColor: ['#198754', '#fd7e14', '#dc3545', '#6c757d', '#0d6efd']
                            }]
                        }
                    });
                }

                if (movementsResponse.ok) {
                    const movementsData = await movementsResponse.json();
                    renderRecentMovements(Array.isArray(movementsData?.items) ? movementsData.items : []);
                }

                document.getElementById('dashboardViewAllMovements')?.addEventListener('click', event => {
                    event.preventDefault();
                    window.dispatchEvent(new CustomEvent('app:navigate', { detail: { url: '/Operaciones/Historial' } }));
                });
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init, { once: true });
            } else {
                init();
            }
        })();
    </script>
}

                <div class="kpi-icon red">

                    <i class="bi bi-exclamation-triangle-fill"></i>

                </div>

            </div>

        </div>

    </div>

    <!-- CHARTS -->

    <div class="row g-4 mb-4">

        <div class="col-lg-8">

            <div class="card-custom">

                <div class="card-header-custom">

                    Distribución de Bienes por Área

                </div>

                <div class="card-body">

                    <canvas id="assetsChart"
                            height="120"></canvas>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card-custom">

                <div class="card-header-custom">

                    Estado de Activos

                </div>

                <div class="card-body">

                    <canvas id="statusChart"></canvas>

                </div>

            </div>

        </div>

    </div>

    <!-- TABLA -->

    <div class="card-custom">

        <div class="card-header-custom d-flex justify-content-between">

            <span>
                Movimientos Recientes
            </span>

            <button class="btn btn-sm btn-primary" id="dashboardViewAllMovements" type="button">
                Ver todos
            </button>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>Código</th>
                        <th>Activo</th>
                        <th>Movimiento</th>
                        <th>Usuario</th>
                        <th>Fecha</th>
                        <th>Estado</th>

                    </tr>

                </thead>

                <tbody id="dashboardRecentMovementsRows">
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Sin movimientos recientes para mostrar.</td>
                    </tr>
                </tbody>

            </table>

        </div>

    </div>

</div>