@using System.Security.Claims
@{
    var displayName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Usuario institucional";
    var initials = string.Join("", (displayName ?? "UI").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
}
<nav class="topbar">

    <div class="d-flex align-items-center gap-3">

       @*  <button class="btn btn-light btn-sm shadow-sm" id="sidebarToggle">
            <i class="bi bi-list"></i>
        </button> *@
        <button class="btn btn-light btn-sm shadow-sm rounded-3 px-3"
                id="sidebarToggle">
        
            <i class="bi bi-list fs-5"></i>
        
        </button>

        <div>
            <h5 class="mb-0 fw-bold">
                Sistema Integral de Control Patrimonial e Inventario
            </h5>

            <small class="text-muted">
                Plataforma Ejecutiva Institucional
            </small>
        </div>

    </div>

    <div class="d-flex align-items-center gap-3">

     @*    <button class="btn btn-light" onclick="toggleDarkMode()">
        
            <i class="bi bi-moon-stars-fill"></i>
        
        </button> *@

        <div class="dropdown">

            <button class="btn btn-light position-relative"
                    data-bs-toggle="dropdown">

                <i class="bi bi-bell-fill"></i>

                <span id="notificationCount" class="notification-badge">
                    3
                </span>

            </button>

            <div id="notificationMenu" class="dropdown-menu dropdown-menu-end notification-menu">

                <div class="notification-header">

                    Notificaciones

                </div>

                <span class="dropdown-item text-muted">Cargando...</span>

            </div>

        </div>

     @*    <button class="btn btn-light position-relative">

            <i class="bi bi-bell-fill"></i>

            <span class="notification-badge">
                5
            </span>

        </button> *@

        <div class="user-box">

            <div class="avatar">
                @initials
            </div>

            <div>
                <div class="fw-semibold">
                    @displayName
                </div>

                <small class="text-muted">
                    @(User.IsInRole("Administrator") ? "Administrador General" : "Usuario institucional")
                </small>
            </div>

        </div>
        <form asp-controller="Auth" asp-action="Logout" method="post" class="ms-2">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-light" title="Cerrar sesión"><i class="bi bi-box-arrow-right"></i></button>
        </form>

    </div>

</nav>