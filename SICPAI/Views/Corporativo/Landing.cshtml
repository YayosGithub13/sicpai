@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8">

    <title>SICPAI</title>

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
          rel="stylesheet">

    <link href="~/css/sicpai.css"
          rel="stylesheet">

</head>

<body class="landing-body">

    <!-- NAVBAR -->

    <nav class="navbar navbar-expand-lg navbar-dark landing-navbar" style="background:linear-gradient(180deg, #17324d, #1f4d73);">

        <div class="container">

            <a class="navbar-brand fw-bold fs-3"
               href="#">

                SICPAI

            </a>

            <button class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="menu">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#modulos">

                            Módulos

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           href="#beneficios">

                            Beneficios

                        </a>

                    </li>

                    <li class="nav-item ms-lg-3">

                        <a class="btn btn-light rounded-pill px-4"
                           href="/Auth/Login">

                            Ingresar

                        </a>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- HERO -->

    <section class="hero-section">

        <div class="container">

            <div class="row align-items-center min-vh-100">

                <div class="col-lg-6">

                    <span class="hero-badge">

                        Plataforma Institucional Premium

                    </span>

                    <h1 class="hero-title">

                        Sistema Integral de Control Patrimonial e Inventario

                    </h1>

                    <p class="hero-text">

                        Plataforma moderna para administrar bienes patrimoniales,
                        auditorías, responsables, inventarios y activos institucionales.

                    </p>

                    <div class="d-flex gap-3 flex-wrap">

                        <a href="/Corporativo/Demo"
                           class="btn btn-primary btn-lg px-5">

                            Ver Demo

                        </a>

                        <a href="#modulos"
                           class="btn btn-outline-light btn-lg px-5">

                            Explorar

                        </a>

                    </div>

                </div>

                <div class="col-lg-6">

                    <div class="hero-dashboard">

                        <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=1400"
                             class="img-fluid rounded-4 shadow-lg">

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- MODULOS -->

    <section class="py-5 bg-light"
             id="modulos">

        <div class="container">

            <div class="text-center mb-5">

                <h2 class="fw-bold">

                    Módulos Estratégicos

                </h2>

                <p class="text-muted">

                    Plataforma completa para control institucional

                </p>

            </div>

            <div class="row g-4">

                <div class="col-lg-4">

                    <div class="feature-card">

                        <i class="bi bi-box-seam-fill"></i>

                        <h5>
                            Gestión Patrimonial
                        </h5>

                        <p>
                            Administración completa de bienes y activos.
                        </p>

                    </div>

                </div>

                <div class="col-lg-4">

                    <div class="feature-card">

                        <i class="bi bi-upc-scan"></i>

                        <h5>
                            Escaneo Inteligente
                        </h5>

                        <p>
                            Código de barras y control rápido institucional.
                        </p>

                    </div>

                </div>

                <div class="col-lg-4">

                    <div class="feature-card">

                        <i class="bi bi-graph-up-arrow"></i>

                        <h5>
                            Reportes Ejecutivos
                        </h5>

                        <p>
                            Indicadores y analítica institucional avanzada.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- BENEFICIOS -->

    <section class="py-5"
             id="beneficios">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-lg-6">

                    <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=1400"
                         class="img-fluid rounded-4 shadow">

                </div>

                <div class="col-lg-6">

                    <h2 class="fw-bold mb-4">

                        Beneficios Institucionales

                    </h2>

                    <div class="benefit-item">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>
                            Control total de activos institucionales
                        </span>

                    </div>

                    <div class="benefit-item">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>
                            Trazabilidad y auditoría completa
                        </span>

                    </div>

                    <div class="benefit-item">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>
                            Gestión de responsables y ubicaciones
                        </span>

                    </div>

                    <div class="benefit-item">

                        <i class="bi bi-check-circle-fill"></i>

                        <span>
                            Plataforma moderna y responsive
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- FOOTER -->

    <footer class="landing-footer">

        <div class="container">

            <div class="d-flex justify-content-between flex-wrap">

                <div>

                    <h5 class="fw-bold">
                        SICPAI
                    </h5>

                    <p>
                        Plataforma institucional premium
                    </p>

                </div>

                <div>

                    <p>
                        © 2026 SICPAI
                    </p>

                </div>

            </div>

        </div>

    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>