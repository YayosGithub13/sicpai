                            <input type="text"
                                   class="form-control"
                                   value="$28,500.00">

                        </div>

                        <div class="col-lg-3">

                            <label class="form-label">
                                Fecha de Adquisición
                            </label>

                            <input type="date"
                                   class="form-control">

                        </div>

                        <div class="col-lg-3">

                            <label class="form-label">
                                Número de Cuenta Contable
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="1241-01-001">

                        </div>

                        <div class="col-lg-3">

                            <label class="form-label">
                                % Depreciación Anual
                            </label>

                            <input type="number"
                                   class="form-control"
                                   placeholder="10">

                        </div>

                        <div class="col-lg-4">

                            <label class="form-label">
                                Método de Depreciación
