                            <input type="text"
                                   class="form-control"
                                   placeholder="$0.00">

                        </div>

                        <div class="col-lg-4">

                            <label class="form-label">
                                Depreciación Acumulada
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="$0.00"
                                   readonly>

                        </div>

                        <div class="col-lg-12">

                            <div class="card border shadow-sm">

                                <div class="card-header bg-light">

                                    <strong>

                                        Control de Depreciación

                                    </strong>

                                </div>

                                <div class="card-body">

                                    <div class="progress mb-3"
                                         style="height:22px;">

                                        <div class="progress-bar bg-success"
                                             style="width:35%;">

                                            35 %

                                        </div>

                                    </div>

                                    <small class="text-muted">

                                        Vida útil estimada:
                                        <strong>10 años</strong>

                                        ·

                                        Años transcurridos:
                                        <strong>3.5</strong>

                                    </small>

                                </div>

                            </div>

                        </div>

