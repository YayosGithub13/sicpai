@section Scripts {
    <script>
        document.getElementById('importAssetsButton')?.addEventListener('click', () => document.getElementById('importAssetsFile').click());
        document.getElementById('importAssetsFile')?.addEventListener('change', async event => {
            const file = event.target.files[0]; if (!file) return;
            const form = new FormData(); form.append('file', file);
            const preview = await fetch('/api/assets/import/preview', { method: 'POST', body: form });
            const data = await preview.json();
            if (!preview.ok) { Swal.fire('Importación', data.error || 'No se pudo leer el archivo.', 'error'); return; }
            const invalid = data.rows.filter(row => !row.valid).length;
            const result = await Swal.fire({ title: 'Vista previa', html: `<p>Filas revisadas: <strong>${data.totalPreview}</strong><br>Filas inválidas: <strong>${invalid}</strong></p><p>¿Desea importar el archivo?</p>`, icon: invalid ? 'warning' : 'info', showCancelButton: true, confirmButtonText: 'Importar' });
            if (!result.isConfirmed) return;
            const response = await fetch('/api/assets/import', { method: 'POST', body: form }); const imported = await response.json();
            if (imported.rejected?.length) { const csv = 'Fila,Código,Motivo\n' + imported.rejected.map(row => `${row.row},${row.code},${row.reason}`).join('\n'); const link = document.createElement('a'); link.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); link.download = 'filas-rechazadas.csv'; link.click(); }
            Swal.fire('Importación', `Importados: ${imported.imported || 0}. Rechazados: ${imported.rejected?.length || 0}.`, 'success').then(() => location.reload());
        });
        document.addEventListener('DOMContentLoaded', async () => {
            const body = document.getElementById('assetsTableBody');
            const response = await fetch('/api/assets');
            if (!response.ok) return;
            const assets = await response.json();
            if (!assets.length) { body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No hay bienes registrados.</td></tr>'; return; }
            body.innerHTML = assets.map(asset => `<tr><td><div class="asset-info"><div class="asset-image"><i class="bi bi-box-seam"></i></div><div><div class="fw-semibold">${escapeHtml(asset.name)}</div><small class="text-muted">${escapeHtml(asset.assetType || 'Activo')}</small></div></div></td><td>${escapeHtml(asset.assetCode)}</td><td>${escapeHtml(asset.serialNumber || '-')}</td><td>${escapeHtml(asset.area || '-')}</td><td>${escapeHtml(asset.responsible || '-')}</td><td><span class="badge ${asset.status === 'Activo' ? 'bg-success' : 'bg-warning text-dark'}">${escapeHtml(asset.status)}</span></td><td>${Number(asset.acquisitionValue || 0).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' })}</td><td><a class="btn btn-sm btn-light" href="/Patrimonio/Detail?id=${asset.id}"><i class="bi bi-eye"></i></a></td></tr>`).join('');
        });
        function escapeHtml(value) { const div = document.createElement('div'); div.textContent = value ?? ''; return div.innerHTML; }
    </script>
}

