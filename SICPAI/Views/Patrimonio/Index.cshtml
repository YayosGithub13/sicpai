@{
    ViewData["Title"] = "Bienes Patrimoniales";
}

<div class="container-fluid">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Gestión de Bienes Patrimoniales
            </h2>

            <p class="text-muted mb-0">
                Administración institucional de activos y bienes
            </p>

        </div>

        <div class="d-flex gap-2">

            <button type="button" class="btn btn-light" id="importAssetsButton"><i class="bi bi-upload"></i> Importar Excel</button>
            <input id="importAssetsFile" type="file" accept=".xlsx" hidden />

            <button class="btn btn-light">

                <i class="bi bi-download"></i>
                Exportar

            </button>

            <a href="/Patrimonio/Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>
                Nuevo Bien

            </a>

        </div>

    </div>

    <!-- FILTROS -->
