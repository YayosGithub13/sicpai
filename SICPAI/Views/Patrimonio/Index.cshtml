    <!-- FILTROS -->

    <div class="card-custom mb-4">

        <div class="card-header-custom">

            Filtros Avanzados

        </div>

        <div class="p-4">

            <!-- FILA 1 -->

            <div class="row g-3 mb-3">

                <div class="col-lg-3">

                    <label class="form-label">
                        Código Patrimonial
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="Ej. EQ-000125">

                </div>

                <div class="col-lg-3">

                    <label class="form-label">
                        Sede / Plantel
                    </label>

                    <select class="form-select">

                        <option>Todas las sedes</option>
                        <option>Campus Centro</option>
                        <option>Campus Norte</option>
                        <option>Campus Sur</option>
                        <option>Oficinas Administrativas</option>

                    </select>

                </div>

                <div class="col-lg-3">

                    <label class="form-label">
                        Área / Departamento
                    </label>

                    <select class="form-select">

                        <option>Todas</option>
                        <option>Tecnologías de la Información</option>
                        <option>Administración</option>
                        <option>Finanzas</option>
                        <option>Recursos Humanos</option>

                    </select>

                </div>

                <div class="col-lg-3">

                    <label class="form-label">
                        Responsable
                    </label>

                    <select class="form-select">

                        <option>Todos</option>
                        <option>Juan Pérez</option>
                        <option>María López</option>

                    </select>

                </div>

            </div>

            <!-- FILA 2 -->

            <div class="row g-3 align-items-end">

                <div class="col-lg-3">

                    <label class="form-label">
                        Estado del Bien
                    </label>

                    <select class="form-select">

                        <option>Todos</option>
                        <option>Activo</option>
                        <option>En reparación</option>
                        <option>Dañado</option>
                        <option>Extraviado</option>
                        <option>Baja definitiva</option>

                    </select>

                </div>

                <div class="col-lg-2">

                    <label class="form-label">
                        Fecha Desde
                    </label>

                    <input type="date"
                           class="form-control">

                </div>

                <div class="col-lg-2">

                    <label class="form-label">
                        Fecha Hasta
                    </label>

                    <input type="date"
                           class="form-control">

                </div>

                <div class="col-lg-5 text-end">

