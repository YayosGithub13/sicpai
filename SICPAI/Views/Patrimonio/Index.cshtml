    <!-- FILTROS -->

    <div class="card-custom mb-4">

        <div class="card-header-custom">

            Filtros Avanzados

        </div>

        <div class="p-4">

            <!-- FILA 1 -->

            <div class="row g-3 mb-3">

                <div class="col-lg-3">

                    <label class="form-label">
                        Código Patrimonial
                    </label>

                    <input type="text"
                           id="assetSearch"
                           class="form-control"
                           placeholder="Código o nombre del bien">

                </div>

                <div class="col-lg-3">

                    <label class="form-label">
                        Sede / Plantel
                    </label>

                    <select class="form-select">

                        <option>Todas las sedes</option>
                        <option>Campus Centro</option>
                        <option>Campus Norte</option>
                        <option>Campus Sur</option>
                        <option>Oficinas Administrativas</option>

                    </select>

                </div>

                <div class="col-lg-3">

                    <label class="form-label">
                        Área / Departamento
                    </label>

                    <select class="form-select" id="assetAreaFilter">

                        <option>Todas</option>
                        <option>Tecnologías de la Información</option>
                        <option>Administración</option>
                        <option>Finanzas</option>
                        <option>Recursos Humanos</option>

                    </select>

                </div>

                <div class="col-lg-3">

                    <label class="form-label">
                        Responsable
                    </label>

                    <select class="form-select">

                        <option>Todos</option>

                    </select>

                </div>

            </div>

            <!-- FILA 2 -->

            <div class="row g-3 align-items-end">

                <div class="col-lg-3">

                    <label class="form-label">
                        Estado del Bien
                    </label>

                    <select class="form-select" id="assetStatusFilter">

                        <option>Todos</option>
                        <option>Activo</option>
                        <option>En reparación</option>
                        <option>Dañado</option>
                        <option>Extraviado</option>
                        <option>Baja definitiva</option>

                    </select>

                </div>

                <div class="col-lg-2">

                    <label class="form-label">
                        Fecha Desde
                    </label>

                    <input type="date"
                           class="form-control">

                </div>

                <div class="col-lg-2">

                    <label class="form-label">
                        Fecha Hasta
                    </label>

                    <input type="date"
                           class="form-control">

                </div>

                <div class="col-lg-5 text-end">

                    <button class="btn btn-outline-secondary me-2" id="clearAssetFilters" type="button">

                        <i class="bi bi-arrow-clockwise"></i>
                        Limpiar

                    </button>

                    <button class="btn btn-primary" id="searchAssetsButton" type="button">

                        <i class="bi bi-search"></i>
                        Buscar

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- TABLA -->

    <div class="card-custom">

        <div class="card-header-custom d-flex justify-content-between align-items-center">

            <span>
                Inventario Institucional
            </span>

            <div class="d-flex gap-2">

                <a class="btn btn-sm btn-outline-primary" id="exportAssetsExcel" href="/api/reportes/inventario/excel">
                    Excel
                </a>

                <a class="btn btn-sm btn-outline-danger" id="exportAssetsPdf" href="/api/reportes/inventario/pdf">
                    PDF
                </a>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Activo</th>
                        <th>Código</th>
                        <th>Serie</th>
                        <th>Área</th>
                        <th>Responsable</th>
                        <th>Estado</th>
                        <th>Valor</th>
                        <th>Acciones</th>

                    </tr>

                </thead>

                <tbody id="assetsTableBody">
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Cargando inventario...</td>
                    </tr>
                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.getElementById('importAssetsButton')?.addEventListener('click', () => document.getElementById('importAssetsFile').click());
        document.getElementById('importAssetsFile')?.addEventListener('change', async event => {
            const file = event.target.files[0]; if (!file) return;
            const form = new FormData(); form.append('file', file);
            const preview = await fetch('/api/assets/import/preview', { method: 'POST', body: form });
            const data = await preview.json();
            if (!preview.ok) { Swal.fire('Importación', data.error || 'No se pudo leer el archivo.', 'error'); return; }
            const invalid = data.rows.filter(row => !row.valid).length;
            const result = await Swal.fire({ title: 'Vista previa', html: `<p>Filas revisadas: <strong>${data.totalPreview}</strong><br>Filas inválidas: <strong>${invalid}</strong></p><p>¿Desea importar el archivo?</p>`, icon: invalid ? 'warning' : 'info', showCancelButton: true, confirmButtonText: 'Importar' });
            if (!result.isConfirmed) return;
            const response = await fetch('/api/assets/import', { method: 'POST', body: form }); const imported = await response.json();
            if (imported.rejected?.length) { const csv = 'Fila,Código,Motivo\n' + imported.rejected.map(row => `${row.row},${row.code},${row.reason}`).join('\n'); const link = document.createElement('a'); link.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); link.download = 'filas-rechazadas.csv'; link.click(); }
            Swal.fire('Importación', `Importados: ${imported.imported || 0}. Rechazados: ${imported.rejected?.length || 0}.`, 'success').then(() => location.reload());
        });
        document.addEventListener('DOMContentLoaded', async () => {
            const body = document.getElementById('assetsTableBody');
            const loadAssets = async () => {
                const params = new URLSearchParams();
                const search = document.getElementById('assetSearch').value.trim();
                const area = document.getElementById('assetAreaFilter').value;
                const status = document.getElementById('assetStatusFilter').value;
                if (search) params.set('search', search);
                if (area && area !== 'Todas') params.set('area', area);
                if (status && status !== 'Todos') params.set('status', status);
                const query = params.toString();
                const response = await fetch(`/api/assets${query ? `?${query}` : ''}`);
                if (!response.ok) return;
                const assets = await response.json();
                const reportQuery = query ? `?${query}` : '';
                document.getElementById('exportAssetsExcel').href = `/api/reportes/inventario/excel${reportQuery}`;
                document.getElementById('exportAssetsPdf').href = `/api/reportes/inventario/pdf${reportQuery}`;
                if (!assets.length) { body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No hay bienes registrados.</td></tr>'; return; }
                body.innerHTML = assets.map(asset => `<tr><td><div class="asset-info"><div class="asset-image"><i class="bi bi-box-seam"></i></div><div><div class="fw-semibold">${escapeHtml(asset.name)}</div><small class="text-muted">${escapeHtml(asset.assetType || 'Activo')}</small></div></div></td><td>${escapeHtml(asset.assetCode)}</td><td>${escapeHtml(asset.serialNumber || '-')}</td><td>${escapeHtml(asset.area || '-')}</td><td>${escapeHtml(asset.responsible || '-')}</td><td><span class="badge ${asset.status === 'Activo' ? 'bg-success' : 'bg-warning text-dark'}">${escapeHtml(asset.status)}</span></td><td>${Number(asset.acquisitionValue || 0).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' })}</td><td><a class="btn btn-sm btn-light" href="/Patrimonio/Detail?id=${asset.id}"><i class="bi bi-eye"></i></a></td></tr>`).join('');
            };
            document.getElementById('searchAssetsButton').addEventListener('click', loadAssets);
            document.getElementById('clearAssetFilters').addEventListener('click', () => { document.getElementById('assetSearch').value = ''; document.getElementById('assetAreaFilter').value = 'Todas'; document.getElementById('assetStatusFilter').value = 'Todos'; loadAssets(); });
            document.getElementById('assetSearch').addEventListener('keydown', event => { if (event.key === 'Enter') loadAssets(); });
            await loadAssets();
        });
        function escapeHtml(value) { const div = document.createElement('div'); div.textContent = value ?? ''; return div.innerHTML; }
    </script>
}