@model int

@{
    ViewData["Title"] = "Expediente del Bien";
}

@section Styles {
    <link rel="stylesheet" href="~/css/detail_expedi_bien.css" asp-append-version="true" />
}

<div class="asset-expediente-container">

    <!-- ================= HEADER EJECUTIVO ================= -->
    <div class="asset-header shadow-sm">

        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

            <div>

                <h2 class="asset-title mb-1" id="detailAssetName">Cargando bien...</h2>

                <div class="d-flex align-items-center gap-2 flex-wrap">

                    <span class="badge bg-secondary px-3 py-2" id="detailAssetStatus">-</span>

                    <span class="text-muted">Código: <strong id="detailAssetCode">-</strong></span>

                    <span class="text-muted">Serie: <strong id="detailAssetSerial">-</strong></span>

                </div>

            </div>

            <div class="d-flex gap-2">

                <button class="btn btn-light" id="detailPrintButton" type="button">
                    <i class="bi bi-printer"></i> Imprimir
                </button>

                <button class="btn btn-primary" id="detailEditButton" type="button">
                    <i class="bi bi-pencil"></i> Editar
                </button>

                <button class="btn btn-outline-danger" id="detailTransferButton" type="button">
                    <i class="bi bi-arrow-left-right"></i> Transferir
                </button>

            </div>

        </div>

    </div>

    <!-- ================= CONTENIDO PRINCIPAL ================= -->
    <div class="row g-4 mt-1">

        <!-- ============ PANEL IZQUIERDO (FICHA EJECUTIVA) ============ -->
        <div class="col-lg-3">

            <div class="asset-side-card shadow-sm">

                <!-- FOTO -->
                <div class="asset-photo">
                    <i class="bi bi-laptop"></i>
                </div>

                <div class="text-center mt-3">

                    <h5 class="mb-1" id="detailMiniName">-</h5>
                    <small class="text-muted" id="detailMiniType">-</small>

                </div>

                <hr>

                <!-- DATOS CLAVE -->
                <div class="asset-mini-info">

                    <div class="mini-item">
                        <span>Área</span>
                        <strong id="detailMiniArea">-</strong>
                    </div>

                    <div class="mini-item">
                        <span>Responsable</span>
                        <strong id="detailMiniResponsible">-</strong>
                    </div>

                    <div class="mini-item">
                        <span>Valor</span>
                        <strong id="detailMiniValue">-</strong>
                    </div>

                    <div class="mini-item">
                        <span>Depreciación</span>
                        <strong id="detailMiniDepreciation">-</strong>
                    </div>

                    <div class="mini-item">
                        <span>Garantía</span>
                        <strong id="detailMiniWarranty">-</strong>
                    </div>

                </div>

                <hr>

                <!-- QR / BARRAS -->
                <div class="text-center">

                    <div class="qr-box mb-2" id="detailQrBox">QR</div>

                    <div class="barcode-box" id="detailBarcodeBox">-</div>

                </div>

                <hr>

                <!-- ACCIONES -->
                <div class="d-grid gap-2">

                    <button class="btn btn-outline-primary btn-sm">
                        Ver QR
                    </button>

                    <button class="btn btn-outline-secondary btn-sm">
                        Etiqueta
                    </button>

                </div>

            </div>

        </div>

        <!-- ============ PANEL DERECHO ============ -->
        <div class="col-lg-9">

            <!-- KPIs -->
            <div class="row g-3 mb-3">

                <div class="col-md-2">
                    <div class="kpi-card">
                        <span>Auditorías</span>
                        <strong id="kpiAudits">0</strong>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="kpi-card">
                        <span>Mantenimientos</span>
                        <strong id="kpiMaintenances">0</strong>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="kpi-card">
                        <span>Transferencias</span>
                        <strong id="kpiTransfers">0</strong>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="kpi-card">
                        <span>Documentos</span>
                        <strong id="kpiDocuments">0</strong>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="kpi-card">
                        <span>Fotos</span>
                        <strong id="kpiPhotos">0</strong>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="kpi-card highlight">
                        <span>Estado</span>
                        <strong id="kpiStatus">-</strong>
                    </div>
                </div>

            </div>

            <!-- TABS PRINCIPALES -->
            <div class="asset-tabs card shadow-sm">

                <ul class="nav nav-tabs px-3 pt-2">

                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#resumen">
                            Resumen
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#ubicacion">
                            Ubicación
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#general">
                            General
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tecnica">
                            Técnica
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#financiero">
                            Financiero
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#documentos">
                            Documentos
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#evidencias">
                            Evidencias
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#historial">
                            Historial
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#auditorias">
                            Auditorías
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#mantenimiento">
                            Mantenimiento
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#transferencias">
                            Transferencias
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#bitacora">
                            Bitácora
                        </button>
                    </li>

                </ul>

                <div class="tab-content p-4">

                    <div class="tab-pane fade show active" id="resumen">
                        <div class="row g-4">

                            <!-- ================= KPI PRINCIPAL ================= -->
                            <div class="col-lg-4">

                                <div class="card shadow-sm p-3">

                                    <h6 class="text-muted">Estado del Activo</h6>

                                    <div class="d-flex align-items-center justify-content-between">

                                        <h4 class="text-success mb-0">Activo</h4>

                                        <span class="badge bg-success fs-6">
                                            Operativo
                                        </span>

                                    </div>

                                    <hr>

                                    <small class="text-muted">
                                        Nivel de riesgo: <strong>Bajo</strong>
                                    </small>

                                </div>

                            </div>

                            <!-- ================= VALOR ================= -->
                            <div class="col-lg-4">

                                <div class="card shadow-sm p-3">

                                    <h6 class="text-muted">Valor del Activo</h6>

                                    <h4 class="mb-0">$28,500.00</h4>

                                    <small class="text-muted">
                                        Valor actual en libros: <strong>$20,300.00</strong>
                                    </small>

                                    <div class="progress mt-2" style="height:8px;">
                                        <div class="progress-bar bg-warning" style="width:35%"></div>
                                    </div>

                                </div>

                            </div>

                            <!-- ================= VIDA ÚTIL ================= -->
                            <div class="col-lg-4">

                                <div class="card shadow-sm p-3">

                                    <h6 class="text-muted">Vida Útil</h6>

                                    <h4>10 años</h4>

                                    <small class="text-muted">
                                        Usado: <strong>3.5 años</strong>
                                    </small>

                                </div>

                            </div>

                        </div>

                        <!-- ================= GRÁFICA ================= -->
                        <div class="row mt-4">

                            <div class="col-lg-8">

                                <div class="card shadow-sm p-3">

                                    <h6 class="mb-3">Depreciación del Activo</h6>

                                    <canvas id="depreciacionChart" height="120"></canvas>

                                </div>

                            </div>

                            <!-- ================= SMART INFO ================= -->
                            <div class="col-lg-4">

                                <div class="card shadow-sm p-3 mb-3">

                                    <h6>Último Mantenimiento</h6>
                                    <strong>03 Jun 2026</strong>

                                </div>

                                <div class="card shadow-sm p-3 mb-3">

                                    <h6>Última Auditoría</h6>
                                    <strong>10 Ago 2026</strong>

                                </div>

                                <div class="card shadow-sm p-3 mb-3">

                                    <h6>Ubicación Actual</h6>
                                    <strong>Edificio A - TI</strong>

                                </div>

                                <div class="card shadow-sm p-3">

                                    <h6>Transferencias</h6>
                                    <strong>5 movimientos</strong>

                                </div>

                            </div>

                        </div>

                        <!-- ================= TIMELINE RESUMIDO ================= -->
                        <div class="card shadow-sm mt-4 p-3">

                            <h6 class="mb-3">Actividad Reciente</h6>

                            <ul class="list-group list-group-flush">

                                <li class="list-group-item">
                                    <strong>Auditoría completada</strong> - 10 Ago 2026
                                </li>

                                <li class="list-group-item">
                                    <strong>Mantenimiento preventivo</strong> - 03 Jun 2026
                                </li>

                                <li class="list-group-item">
                                    <strong>Transferencia de área</strong> - 27 May 2026
                                </li>

                                <li class="list-group-item">
                                    <strong>Alta del activo</strong> - 15 Ene 2026
                                </li>

                            </ul>

                        </div>
                    </div>
                    
                    <div class="tab-pane fade" id="ubicacion">

                        <div class="row g-4">

                            <div class="col-lg-3">
                                <div class="info-box">
                                    <label>Sede / Plantel</label>
                                    <h6>Campus Centro</h6>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="info-box">
                                    <label>Área / Departamento</label>
                                    <h6 id="detailTabArea">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="info-box">
                                    <label>Responsable</label>
                                    <h6 id="detailTabResponsible">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="info-box">
                                    <label>Encargado de Resguardo</label>
                                    <h6 id="detailTabCustodian">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="info-box">
                                    <label>Ubicación Física</label>
                                    <h6 id="detailTabLocation">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="info-box">
                                    <label>Observaciones de Ubicación</label>
                                    <h6 id="detailTabLocationNotes">-</h6>
                                </div>
                            </div>

                        </div>

                    </div>


                    <div class="tab-pane fade" id="general">

                        <div class="row g-4">

                            <div class="col-lg-4">
                                <div class="info-box">
                                    <label>Código Patrimonial</label>
                                    <h6 id="detailGeneralCode">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="info-box">
                                    <label>Número de Serie</label>
                                    <h6 id="detailGeneralSerial">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="info-box">
                                    <label>Estado del Bien</label>
                                    <h6><span class="badge bg-secondary" id="detailGeneralStatus">-</span></h6>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="info-box">
                                    <label>Tipo de Activo</label>
                                    <h6 id="detailGeneralType">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="info-box">
                                    <label>Marca</label>
                                    <h6 id="detailGeneralBrand">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="info-box">
                                    <label>Modelo</label>
                                    <h6 id="detailGeneralModel">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="info-box">
                                    <label>Descripción</label>
                                    <h6 id="detailGeneralDescription">-</h6>
                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="tab-pane fade" id="tecnica">

                        <!-- ================= IDENTIFICACIÓN TÉCNICA ================= -->
                        <div class="card shadow-sm mb-4">

                            <div class="card-header bg-light">
                                <strong>Identificación Técnica</strong>
                            </div>

                            <div class="card-body">

                                <div class="row g-4">

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>Fabricante</label>
                                            <h6>Dell Technologies</h6>
                                        </div>
                                    </div>

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>Proveedor</label>
                                            <h6>Grupo Computación del Sureste</h6>
                                        </div>
                                    </div>

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>País de Origen</label>
                                            <h6>Estados Unidos</h6>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ================= GARANTÍA ================= -->
                        <div class="card shadow-sm mb-4">

                            <div class="card-header bg-light">
                                <strong>Garantía</strong>
                            </div>

                            <div class="card-body">

                                <div class="row g-4">

                                    <div class="col-lg-3">
                                        <div class="info-box">
                                            <label>Inicio</label>
                                            <h6 id="detailWarrantyStart">-</h6>
                                        </div>
                                    </div>

                                    <div class="col-lg-3">
                                        <div class="info-box">
                                            <label>Fin</label>
                                            <h6 id="detailWarrantyEnd">-</h6>
                                        </div>
                                    </div>

                                    <div class="col-lg-3">
                                        <div class="info-box">
                                            <label>Años de Garantía</label>
                                            <h6 id="detailWarrantyYears">-</h6>
                                        </div>
                                    </div>

                                    <div class="col-lg-3">
                                        <div class="info-box">
                                            <label>Estado</label>
                                            <h6><span class="badge bg-secondary" id="detailWarrantyStatus">-</span></h6>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ================= MANTENIMIENTO ================= -->
                        <div class="card shadow-sm mb-4">

                            <div class="card-header bg-light">
                                <strong>Control de Mantenimiento</strong>
                            </div>

                            <div class="card-body">

                                <div class="row g-4">

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>Último mantenimiento</label>
                                            <h6 id="detailMaintenanceLast">-</h6>
                                        </div>
                                    </div>

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>Próximo mantenimiento</label>
                                            <h6 id="detailMaintenanceNext">-</h6>
                                        </div>
                                    </div>

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>Periodicidad</label>
                                            <h6 id="detailMaintenancePeriodicity">-</h6>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ================= IDENTIFICADORES ================= -->
                        <div class="card shadow-sm mb-4">

                            <div class="card-header bg-light">
                                <strong>Identificadores Institucionales</strong>
                            </div>

                            <div class="card-body">

                                <div class="row g-4">

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>Código de Barras</label>
                                            <h6 id="detailTechBarcode">-</h6>
                                        </div>
                                    </div>

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>Código QR</label>
                                            <h6 id="detailTechQr">-</h6>
                                        </div>
                                    </div>

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>RFID</label>
                                            <h6 id="detailTechRfid">-</h6>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ================= SEGURO ================= -->
                        <div class="card shadow-sm mb-4">

                            <div class="card-header bg-light">
                                <strong>Seguro del Bien</strong>
                            </div>

                            <div class="card-body">

                                <div class="row g-4">

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>Aseguradora</label>
                                            <h6 id="detailInsuranceProvider">-</h6>
                                        </div>
                                    </div>

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>Número de Póliza</label>
                                            <h6 id="detailInsurancePolicy">-</h6>
                                        </div>
                                    </div>

                                    <div class="col-lg-4">
                                        <div class="info-box">
                                            <label>Vencimiento</label>
                                            <h6>15/01/2027</h6>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ================= EVIDENCIA FOTOGRÁFICA ================= -->
                        <div class="card shadow-sm mb-4">

                            <div class="card-header bg-light">
                                <strong>Evidencia Fotográfica</strong>
                            </div>

                            <div class="card-body">

                                <div class="row g-3">

                                    <div class="col-lg-3">
                                        <div class="border rounded p-4 text-center">
                                            <i class="bi bi-image fs-1 text-primary"></i>
                                            <br><br>
                                            <button class="btn btn-outline-primary btn-sm">
                                                Agregar fotografía
                                            </button>
                                        </div>
                                    </div>

                                    <div class="col-lg-3">
                                        <img src="https://placehold.co/250x180" class="img-fluid rounded shadow-sm">
                                    </div>

                                    <div class="col-lg-3">
                                        <img src="https://placehold.co/250x180" class="img-fluid rounded shadow-sm">
                                    </div>

                                    <div class="col-lg-3">
                                        <img src="https://placehold.co/250x180" class="img-fluid rounded shadow-sm">
                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ================= OBSERVACIONES ================= -->
                        <div class="card shadow-sm">

                            <div class="card-header bg-light">
                                <strong>Observaciones Técnicas</strong>
                            </div>

                            <div class="card-body">

                                <h6 id="detailTechnicalNotes">Sin observaciones técnicas registradas.</h6>

                            </div>

                        </div>

                    </div>

                    <div class="tab-pane fade" id="financiero">

                        <div class="row g-4">

                            <div class="col-lg-3">
                                <div class="info-box">
                                    <label>Valor del Bien</label>
                                    <h6 id="detailFinancialValue">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="info-box">
                                    <label>Fecha de Adquisición</label>
                                    <h6 id="detailFinancialAcquisitionDate">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="info-box">
                                    <label>Cuenta Contable</label>
                                    <h6 id="detailFinancialAccount">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="info-box">
                                    <label>% Depreciación</label>
                                    <h6 id="detailFinancialDepreciationRate">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="info-box">
                                    <label>Método Depreciación</label>
                                    <h6 id="detailFinancialDepreciationMethod">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="info-box">
                                    <label>Valor Residual</label>
                                    <h6 id="detailFinancialResidualValue">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="info-box">
                                    <label>Depreciación Acumulada</label>
                                    <h6 id="detailFinancialAccumulatedDepreciation">-</h6>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="card shadow-sm p-3">
                                    <h6>Control de Depreciación</h6>

                                    <div class="progress" style="height:20px;">
                                        <div class="progress-bar bg-warning" id="detailFinancialDepreciationBar" style="width:0%">
                                            0%
                                        </div>
                                    </div>

                                    <small class="text-muted mt-2 d-block" id="detailFinancialUsefulLife">Vida útil no calculada</small>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="info-box">
                                    <label>Factura</label>
                                    <h6 id="detailFinancialInvoiceStatus">Sin factura asociada</h6>
                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="tab-pane fade" id="documentos">
                        <div class="row g-4">

                            <!-- ================= ZONA DE SUBIDA ================= -->
                            <div class="col-lg-4">

                                <div class="card shadow-sm p-3 text-center h-100">

                                    <i class="bi bi-cloud-arrow-up fs-1 text-primary"></i>

                                    <h6 class="mt-3">Subir Documentos</h6>

                                    <p class="text-muted small">
                                        PDF, imágenes, facturas, pólizas
                                    </p>

                                    <input type="file"
                                           class="form-control mt-2"
                                           multiple
                                           accept=".pdf,.jpg,.jpeg,.png">

                                    <button class="btn btn-primary mt-3 w-100">
                                        Cargar Archivos
                                    </button>

                                </div>

                            </div>

                            <!-- ================= LISTADO DE DOCUMENTOS ================= -->
                            <div class="col-lg-8">

                                <div class="card shadow-sm p-3">

                                    <h6 class="mb-3">Documentos del Activo</h6>

                                    <table class="table table-hover align-middle">

                                        <thead class="table-light">

                                            <tr>
                                                <th>Tipo</th>
                                                <th>Nombre</th>
                                                <th>Fecha</th>
                                                <th>Acciones</th>
                                            </tr>

                                        </thead>

                                        <tbody id="detailDocumentsRows"><tr><td colspan="4" class="text-center text-muted py-3">Sin documentos cargados.</td></tr></tbody>

                                    </table>

                                </div>

