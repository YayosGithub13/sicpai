                                        <th>Fecha</th>
                                        <th>Usuario</th>
                                        <th>Acciones</th>
                                    </tr>

                                </thead>

                                <tbody id="detailEvidenceRows"><tr><td colspan="5" class="text-center text-muted py-3">Sin evidencias registradas.</td></tr></tbody>

                            </table>

                        </div>

                    </div>

                    <div class="tab-pane fade" id="historial">

                        <!-- ================= RESUMEN DE HISTORIAL ================= -->
                        <div class="row g-3 mb-4">

                            <div class="col-lg-3">
                                <div class="card shadow-sm p-3 text-center">
                                    <h6 class="text-muted">Movimientos</h6>
                                    <h3 id="detailHistMovements">0</h3>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="card shadow-sm p-3 text-center">
                                    <h6 class="text-muted">Auditorías</h6>
                                    <h3 id="detailHistAudits">0</h3>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="card shadow-sm p-3 text-center">
                                    <h6 class="text-muted">Mantenimientos</h6>
                                    <h3 id="detailHistMaintenances">0</h3>
                                </div>
                            </div>

                            <div class="col-lg-3">
                                <div class="card shadow-sm p-3 text-center">
                                    <h6 class="text-muted">Eventos</h6>
                                    <h3 id="detailHistEvents">0</h3>
                                </div>
                            </div>

                        </div>

                        <!-- ================= TIMELINE UNIFICADO ================= -->
                        <div class="card shadow-sm p-3">

                            <h6 class="mb-3">Línea de Tiempo del Activo</h6>

                            <div class="timeline" id="detailTimeline"><div class="text-muted">Sin movimientos registrados.</div></div>

                        </div>

                    </div>

                    <div class="tab-pane fade" id="auditorias">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <h5 class="mb-0">Auditorías del Activo</h5>

                            <button class="btn btn-primary btn-sm">
                                <i class="bi bi-plus-circle"></i> Nueva Auditoría
                            </button>

                        </div>

                        <!-- FORM RESUMIDO -->
                        <div class="card shadow-sm p-3 mb-4">

                            <div class="row g-3">

                                <div class="col-md-3">
                                    <label class="form-label">Fecha</label>
                                    <input type="date" class="form-control">
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Auditor</label>
                                    <input type="text" class="form-control" placeholder="Nombre">
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Resultado</label>
                                    <select class="form-select">
                                        <option>Conforme</option>
                                        <option>No conforme</option>
                                        <option>Observación</option>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Estado físico</label>
                                    <select class="form-select">
                                        <option>Óptimo</option>
                                        <option>Regular</option>
                                        <option>Dañado</option>
                                    </select>
                                </div>

                            </div>

                            <div class="mt-3">
                                <textarea class="form-control" rows="2" placeholder="Observaciones"></textarea>
                            </div>

                        </div>

                        <!-- HISTORIAL -->
                        <div class="card shadow-sm p-3">

                            <h6 class="mb-3">Historial de Auditorías</h6>

                            <table class="table table-hover align-middle">

                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Auditor</th>
                                        <th>Resultado</th>
                                        <th>Estado</th>
                                        <th>Observaciones</th>
                                    </tr>
                                </thead>

                                <tbody id="detailAuditsRows"><tr><td colspan="5" class="text-center text-muted py-3">Sin auditorías registradas.</td></tr></tbody>

                            </table>

                        </div>

                    </div>

                    <div class="tab-pane fade" id="mantenimiento">

                        <div class="row g-4">

                            <!-- FORM -->
                            <div class="col-lg-4">

                                <div class="card shadow-sm p-3">

                                    <h6>Nuevo Mantenimiento</h6>

                                    <label class="form-label mt-2">Tipo</label>
                                    <select class="form-select" id="detailMaintenanceType">
                                        <option>Preventivo</option>
                                        <option>Correctivo</option>
                                    </select>

                                    <label class="form-label mt-2">Fecha</label>
                                    <input type="date" class="form-control" id="detailMaintenanceDate">

                                    <label class="form-label mt-2">Técnico</label>
                                    <input type="text" class="form-control" id="detailMaintenanceTechnician">

                                    <label class="form-label mt-2">Costo</label>
                                    <input type="number" class="form-control" id="detailMaintenanceCost">

                                    <button class="btn btn-primary w-100 mt-3" id="detailMaintenanceSubmit" type="button">
                                        Registrar
                                    </button>

                                </div>

                            </div>

                            <!-- HISTORIAL -->
                            <div class="col-lg-8">

                                <div class="card shadow-sm p-3">

                                    <h6>Historial de Mantenimientos</h6>

                                    <table class="table table-hover">

                                        <thead class="table-light">
                                            <tr>
                                                <th>Tipo</th>
                                                <th>Fecha</th>
                                                <th>Técnico</th>
                                                <th>Costo</th>
                                            </tr>
                                        </thead>

                                        <tbody id="detailMaintenanceRows"><tr><td colspan="4" class="text-center text-muted py-3">Sin mantenimientos registrados.</td></tr></tbody>

                                    </table>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="tab-pane fade" id="transferencias">

                        <div class="card shadow-sm p-3">

                            <h6>Historial de Transferencias</h6>

                            <table class="table table-hover">

                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Origen</th>
                                        <th>Destino</th>
                                        <th>Responsable</th>
                                    </tr>
                                </thead>

                                <tbody id="detailTransfersRows"><tr><td colspan="4" class="text-center text-muted py-3">Sin transferencias registradas.</td></tr></tbody>

                            </table>

                        </div>

                    </div>

                    <div class="tab-pane fade" id="bitacora">

                        <div class="card shadow-sm p-3">

                            <h6>Registro de Actividad del Sistema</h6>

                            <ul class="list-group list-group-flush" id="detailBitacoraRows"><li class="list-group-item text-muted">Sin actividad registrada.</li></ul>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts{
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const formatCurrency = value => Number(value || 0).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
            const getDepreciationRate = assetType => {
                const normalized = (assetType || '').toString().toLowerCase();
                if (normalized.includes('computadora') || normalized.includes('cómputo') || normalized.includes('computo')) return 0.30;
                if (normalized.includes('vehículo') || normalized.includes('vehiculo')) return 0.25;
                if (normalized.includes('herramienta')) return 0.20;
                return 0.10;
            };

            document.getElementById('detailPrintButton')?.addEventListener('click', () => window.print());
            document.getElementById('detailEditButton')?.addEventListener('click', () => {
                window.dispatchEvent(new CustomEvent('app:navigate', { detail: { url: '/Patrimonio/Index' } }));
            });
            document.getElementById('detailTransferButton')?.addEventListener('click', () => {
                window.dispatchEvent(new CustomEvent('app:navigate', { detail: { url: '/Operaciones/Transferencias' } }));
            });

            const response = await fetch(`/api/assets/@Model`);
            if (!response.ok) {
                window.dispatchEvent(new CustomEvent('app:navigate', { detail: { url: '/Patrimonio/Index' } }));
                return;
            }

            const asset = await response.json();
            document.getElementById('detailAssetName').textContent = asset.name || 'Bien patrimonial';
            document.getElementById('detailAssetCode').textContent = asset.assetCode || '-';
            document.getElementById('detailAssetSerial').textContent = asset.serialNumber || '-';
            const status = document.getElementById('detailAssetStatus');
            status.textContent = asset.status || '-';
            status.className = `badge px-3 py-2 ${asset.status === 'Activo' ? 'bg-success' : 'bg-warning text-dark'}`;

            document.getElementById('detailMiniName').textContent = asset.name || '-';
            document.getElementById('detailMiniType').textContent = asset.assetType || '-';
            document.getElementById('detailMiniArea').textContent = asset.area || '-';
            document.getElementById('detailMiniResponsible').textContent = asset.responsible || '-';
            document.getElementById('detailMiniValue').textContent = formatCurrency(asset.acquisitionValue || 0);
            const acquisitionDate = asset.acquisitionDate ? new Date(asset.acquisitionDate) : null;
            const depreciationRateDecimal = getDepreciationRate(asset.assetType);
            const yearsUsed = acquisitionDate ? Math.max(0, (new Date() - acquisitionDate) / (1000 * 60 * 60 * 24 * 365.25)) : 0;
            const depreciation = asset.acquisitionValue > 0 && Number.isFinite(asset.acquisitionValue)
                ? `${Math.min(100, Math.round(depreciationRateDecimal * 100 * yearsUsed))}%`
                : '-';
            document.getElementById('detailMiniDepreciation').textContent = depreciation;
            document.getElementById('detailMiniWarranty').textContent = acquisitionDate ? 'Calculada' : '-';
            document.getElementById('detailBarcodeBox').textContent = asset.barcode || '-';
            document.getElementById('detailQrBox').textContent = asset.assetCode || '-';

            document.getElementById('detailTabArea').textContent = asset.area || '-';
            document.getElementById('detailTabResponsible').textContent = asset.responsible || '-';
            document.getElementById('detailTabCustodian').textContent = asset.responsible || '-';
            document.getElementById('detailTabLocation').textContent = asset.location || '-';
            document.getElementById('detailTabLocationNotes').textContent = asset.location ? `Ubicación actual: ${asset.location}` : '-';

            document.getElementById('detailGeneralCode').textContent = asset.assetCode || '-';
            document.getElementById('detailGeneralSerial').textContent = asset.serialNumber || '-';
            const generalStatus = document.getElementById('detailGeneralStatus');
            generalStatus.textContent = asset.status || '-';
            generalStatus.className = `badge ${asset.status === 'Activo' ? 'bg-success' : 'bg-warning text-dark'}`;
            document.getElementById('detailGeneralType').textContent = asset.assetType || '-';
            document.getElementById('detailGeneralBrand').textContent = asset.brand || '-';
            document.getElementById('detailGeneralModel').textContent = asset.model || '-';
            document.getElementById('detailGeneralDescription').textContent = asset.name ? `Activo registrado: ${asset.name}` : '-';

            document.getElementById('detailTechBarcode').textContent = asset.barcode || '-';
            document.getElementById('detailTechQr').textContent = asset.assetCode || '-';
            document.getElementById('detailTechRfid').textContent = asset.assetCode ? `RFID-${asset.assetCode}` : '-';

            document.getElementById('detailWarrantyStart').textContent = acquisitionDate ? acquisitionDate.toLocaleDateString('es-MX') : '-';
            if (acquisitionDate) {
                const warrantyEnd = new Date(acquisitionDate);
                warrantyEnd.setFullYear(warrantyEnd.getFullYear() + 3);
                document.getElementById('detailWarrantyEnd').textContent = warrantyEnd.toLocaleDateString('es-MX');
                document.getElementById('detailWarrantyYears').textContent = '3 años';
                const warrantyStatus = document.getElementById('detailWarrantyStatus');
                const vigente = warrantyEnd >= new Date();
                warrantyStatus.textContent = vigente ? 'Vigente' : 'Vencida';
                warrantyStatus.className = `badge ${vigente ? 'bg-success' : 'bg-secondary'}`;
            } else {
                document.getElementById('detailWarrantyEnd').textContent = '-';
                document.getElementById('detailWarrantyYears').textContent = '-';
                document.getElementById('detailWarrantyStatus').textContent = '-';
            }

            const movements = Array.isArray(asset.movements) ? asset.movements : [];
            const maintenanceMovements = movements.filter(m => m.movementType === 'Mantenimiento').sort((a, b) => new Date(b.occurredAt) - new Date(a.occurredAt));
            document.getElementById('detailMaintenanceLast').textContent = maintenanceMovements.length ? new Date(maintenanceMovements[0].occurredAt).toLocaleDateString('es-MX') : '-';
            document.getElementById('detailMaintenanceNext').textContent = maintenanceMovements.length ? (() => {
                const next = new Date(maintenanceMovements[0].occurredAt);
                next.setMonth(next.getMonth() + 3);
                return next.toLocaleDateString('es-MX');
            })() : '-';
            document.getElementById('detailMaintenancePeriodicity').textContent = maintenanceMovements.length ? 'Derivada de historial' : '-';

            document.getElementById('detailInsuranceProvider').textContent = asset.status === 'Baja' ? '-' : 'Pendiente de captura';
            document.getElementById('detailInsurancePolicy').textContent = asset.status === 'Baja' ? '-' : 'Pendiente de captura';
            document.getElementById('detailInsuranceCoverage').textContent = asset.status === 'Baja' ? '-' : 'Pendiente de captura';
            document.getElementById('detailTechnicalNotes').textContent = asset.name ? `Activo ${asset.name} sin observaciones técnicas adicionales.` : 'Sin observaciones técnicas registradas.';

            const acquisitionValue = Number(asset.acquisitionValue || 0);
            document.getElementById('detailFinancialValue').textContent = formatCurrency(acquisitionValue);
            document.getElementById('detailFinancialAcquisitionDate').textContent = acquisitionDate ? acquisitionDate.toLocaleDateString('es-MX') : '-';
            document.getElementById('detailFinancialAccount').textContent = asset.assetType ? `Cuenta ${asset.assetType}` : '-';
            const depreciationRate = acquisitionValue > 0 ? Math.round(depreciationRateDecimal * 100) : 0;
            document.getElementById('detailFinancialDepreciationRate').textContent = depreciationRate ? `${depreciationRate}%` : '-';
            document.getElementById('detailFinancialDepreciationMethod').textContent = depreciationRate ? 'Línea Recta' : '-';
            const accumulated = depreciationRate ? Math.min(acquisitionValue, acquisitionValue * ((depreciationRateDecimal) * yearsUsed)) : 0;
            const residual = Math.max(0, acquisitionValue - accumulated);
            document.getElementById('detailFinancialResidualValue').textContent = formatCurrency(residual);
            document.getElementById('detailFinancialAccumulatedDepreciation').textContent = formatCurrency(accumulated);
            const depreciationPercent = acquisitionValue > 0 ? Math.round((accumulated / acquisitionValue) * 100) : 0;
            const depreciationBar = document.getElementById('detailFinancialDepreciationBar');
            depreciationBar.style.width = `${depreciationPercent}%`;
            depreciationBar.textContent = `${depreciationPercent}%`;
            document.getElementById('detailFinancialUsefulLife').textContent = acquisitionDate ? `Vida útil estimada: 10 años · Uso: ${yearsUsed.toFixed(1)} años` : 'Vida útil no calculada';
            document.getElementById('detailFinancialInvoiceStatus').textContent = asset.status === 'Baja' ? 'No aplica' : 'Pendiente de captura';

            document.getElementById('kpiAudits').textContent = '0';
            document.getElementById('kpiMaintenances').textContent = movements.filter(m => m.movementType === 'Mantenimiento').length.toString();
            document.getElementById('kpiTransfers').textContent = movements.filter(m => m.movementType === 'Transferencia').length.toString();
            document.getElementById('kpiDocuments').textContent = '0';
            document.getElementById('kpiPhotos').textContent = '0';
            document.getElementById('kpiStatus').textContent = asset.status || '-';

            document.getElementById('detailHistMovements').textContent = movements.length.toString();
            document.getElementById('detailHistAudits').textContent = '0';
            document.getElementById('detailHistMaintenances').textContent = movements.filter(m => m.movementType === 'Mantenimiento').length.toString();
            document.getElementById('detailHistEvents').textContent = movements.length.toString();

            const timeline = document.getElementById('detailTimeline');
            timeline.innerHTML = movements.length
                ? movements.map(item => {
                    const typeClass = item.movementType === 'Transferencia' ? 'bg-warning text-dark'
                        : item.movementType === 'Mantenimiento' ? 'bg-info'
                        : item.movementType === 'Baja' ? 'bg-danger'
                        : 'bg-primary';
                    const by = item.performedBy ? ` · Usuario: ${item.performedBy}` : '';
                    return `<div class="d-flex mb-3"><div class="me-3"><span class="badge ${typeClass}">${item.movementType || 'Evento'}</span></div><div><h6 class="mb-1">${item.description || 'Sin descripción'}</h6><small class="text-muted">${new Date(item.occurredAt).toLocaleString('es-MX')}${by}</small></div></div>`;
                }).join('')
                : '<div class="text-muted">Sin movimientos registrados.</div>';

            const transfers = movements.filter(item => item.movementType === 'Transferencia');
            const transferRows = document.getElementById('detailTransfersRows');
            transferRows.innerHTML = transfers.length
                ? transfers.map(item => `<tr><td>${new Date(item.occurredAt).toLocaleDateString('es-MX')}</td><td>${item.fromArea || '-'}</td><td>${item.toArea || '-'}</td><td>${item.performedBy || '-'}</td></tr>`).join('')
                : '<tr><td colspan="4" class="text-center text-muted py-3">Sin transferencias registradas.</td></tr>';

            const maintenanceRows = document.getElementById('detailMaintenanceRows');
            maintenanceRows.innerHTML = maintenanceMovements.length
                ? maintenanceMovements.map(item => `<tr><td><span class="badge bg-info">Mantenimiento</span></td><td>${new Date(item.occurredAt).toLocaleDateString('es-MX')}</td><td>${item.performedBy || '-'}</td><td>-</td></tr>`).join('')
                : '<tr><td colspan="4" class="text-center text-muted py-3">Sin mantenimientos registrados.</td></tr>';

            const auditsRows = document.getElementById('detailAuditsRows');
            auditsRows.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Sin auditorías vinculadas a este activo.</td></tr>';

            document.getElementById('detailMaintenanceSubmit')?.addEventListener('click', async () => {
                const type = document.getElementById('detailMaintenanceType').value;
                const technician = document.getElementById('detailMaintenanceTechnician').value.trim();
                const date = document.getElementById('detailMaintenanceDate').value;
                const cost = document.getElementById('detailMaintenanceCost').value;
                const description = [
                    `Tipo: ${type}`,
                    date ? `Fecha: ${date}` : null,
                    technician ? `Técnico: ${technician}` : null,
                    cost ? `Costo: $${cost}` : null
                ].filter(Boolean).join(' · ');

                const maintenanceResponse = await fetch(`/api/assets/${asset.id}/mantenimiento`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ description: description || 'Mantenimiento registrado desde expediente.' })
                });

                if (!maintenanceResponse.ok) {
                    const error = await maintenanceResponse.json().catch(() => null);
                    Swal.fire('Error', error?.error || 'No se pudo registrar el mantenimiento.', 'error');
                    return;
                }

                Swal.fire('Registrado', 'Mantenimiento registrado correctamente.', 'success');
                window.dispatchEvent(new CustomEvent('app:navigate', { detail: { url: `/Patrimonio/Detail/@Model`, force: true } }));
            });

            const documentsRows = document.getElementById('detailDocumentsRows');
            documentsRows.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">Sin documentos cargados.</td></tr>';

            document.getElementById('detailEvidenceCount').textContent = '0 fotos';
            document.getElementById('detailEvidenceGallery').innerHTML = '<div class="col-12 text-muted">Sin evidencias fotográficas registradas.</div>';

            const bitacora = document.getElementById('detailBitacoraRows');
            bitacora.innerHTML = movements.length
                ? movements.slice(0, 8).map(item => `<li class="list-group-item">[${new Date(item.occurredAt).toLocaleString('es-MX')}] ${item.movementType}: ${item.description || 'Sin descripción'}</li>`).join('')
                : '<li class="list-group-item text-muted">Sin actividad registrada.</li>';

            document.getElementById('detailEvidenceRows').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">Sin evidencias registradas.</td></tr>';

            const ctx = document.getElementById('depreciacionChart');
            if (ctx && window.Chart) {
                if (window.sicpaiDetailDepChart) window.sicpaiDetailDepChart.destroy();
                const chartValues = [
                    acquisitionValue,
                    Math.max(0, acquisitionValue * (1 - depreciationRateDecimal)),
                    Math.max(0, acquisitionValue * (1 - depreciationRateDecimal * 2)),
                    Math.max(0, acquisitionValue * (1 - depreciationRateDecimal * 3)),
                    Math.max(0, residual)
                ];

                window.sicpaiDetailDepChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: ['Año 0', 'Año 1', 'Año 2', 'Año 3', 'Actual'],
                        datasets: [{
                            label: 'Valor del Activo',
                            data: chartValues,
                            borderColor: '#1f4d73',
                            backgroundColor: 'rgba(31,77,115,0.1)',
                            tension: 0.4,
                            fill: true
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                display: false
                            }
                        }
                    }
                });
            }
        });
    </script>
}