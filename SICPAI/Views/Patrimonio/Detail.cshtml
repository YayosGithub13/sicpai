                        <!-- ================= HISTORIAL DE EVIDENCIAS ================= -->
                        <div class="card shadow-sm mt-4 p-3">

                            <h6 class="mb-3">Registro de Evidencias</h6>

                            <table class="table table-hover align-middle">

                                <thead class="table-light">

                                    <tr>
                                        <th>Tipo</th>
