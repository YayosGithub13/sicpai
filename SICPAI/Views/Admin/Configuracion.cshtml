@{
    ViewData["Title"] = "Configuración";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Configuración General
            </h2>

            <p class="text-muted">
                Parámetros institucionales del sistema
            </p>

        </div>

        <button class="btn btn-primary">

            Guardar Cambios

        </button>

    </div>

    <div class="row g-4">

        <!-- MENU -->

        <div class="col-lg-3">

            <div class="card-custom">

                <div class="list-group list-group-flush">

                    <a class="list-group-item list-group-item-action active">

                        Generales

                    </a>

                    <a class="list-group-item list-group-item-action">

                        Catálogos

                    </a>

                    <a class="list-group-item list-group-item-action">

                        Seguridad

                    </a>

                    <a class="list-group-item list-group-item-action">

                        Correos

                    </a>

                    <a class="list-group-item list-group-item-action">

                        Respaldos

                    </a>

                </div>

            </div>

        </div>

        <!-- CONTENT -->

        <div class="col-lg-9">

            <div class="card-custom">

                <div class="card-header-custom">

                    Configuración Institucional

                </div>

                <div class="p-4">

                    <div class="row g-4">

                        <div class="col-lg-6">

                            <label class="form-label">
                                Nombre Institución
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="Universidad Institucional">

                        </div>

                        <div class="col-lg-6">

                            <label class="form-label">
                                Folio automático
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="EQ-">

                        </div>

                        <div class="col-lg-6">

                            <label class="form-label">
                                Correo SMTP
                            </label>

                            <input type="text"
                                   class="form-control">

                        </div>

                        <div class="col-lg-6">

                            <label class="form-label">
                                Puerto
                            </label>

                            <input type="text"
                                   class="form-control">

                        </div>

                        <div class="col-lg-12">

                            <label class="form-label">
                                Descripción institucional
                            </label>

                            <textarea class="form-control"
                                      rows="4"></textarea>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>