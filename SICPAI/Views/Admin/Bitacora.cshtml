@{
    ViewData["Title"] = "Bitácora";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h2 class="fw-bold">Bitácora Institucional</h2><p class="text-muted">Registro histórico de actividades del sistema</p></div>
        <button id="refreshLogs" class="btn btn-light" type="button"><i class="bi bi-arrow-clockwise me-2"></i>Actualizar</button>
    </div>

    <div class="card-custom mb-4">
        <div class="card-header-custom"><i class="bi bi-funnel me-2"></i>Filtros de consulta</div>
        <div class="p-4"><div class="row g-3 align-items-end">
            <div class="col-lg-3"><label class="form-label">Acción</label><input id="logAction" class="form-control" placeholder="Crear, Actualizar..."></div>
            <div class="col-lg-3"><label class="form-label">Módulo / entidad</label><input id="logEntity" class="form-control" placeholder="Asset, User..."></div>
            <div class="col-lg-2"><label class="form-label">Desde</label><input id="logFrom" type="date" class="form-control"></div>
            <div class="col-lg-2"><label class="form-label">Hasta</label><input id="logTo" type="date" class="form-control"></div>
            <div class="col-lg-2"><button id="searchLogs" class="btn btn-primary w-100" type="button"><i class="bi bi-search me-2"></i>Buscar</button></div>
        </div></div>
    </div>

    <div class="card-custom">
        <div class="card-header-custom d-flex justify-content-between align-items-center"><span>Actividades registradas</span><span id="logTotal" class="badge bg-light text-primary">0 eventos</span></div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Módulo</th><th>IP</th><th>Descripción</th></tr></thead><tbody id="logRows"></tbody></table></div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const safe = value => { const div = document.createElement('div'); div.textContent = value ?? ''; return div.innerHTML; };
    const load = async () => {
        const params = new URLSearchParams();
        const action = document.getElementById('logAction').value.trim();
        const entity = document.getElementById('logEntity').value.trim();
        const from = document.getElementById('logFrom').value;
        const to = document.getElementById('logTo').value;
        if (action) params.set('action', action);
        if (entity) params.set('entity', entity);
        if (from) params.set('from', from);
        if (to) params.set('to', to);
        const response = await fetch(`/api/bitacora?${params}`);
        if (!response.ok) return;
        const data = await response.json();
        document.getElementById('logTotal').textContent = `${data.total.toLocaleString('es-MX')} eventos`;
        document.getElementById('logRows').innerHTML = data.items.length ? data.items.map(item => `<tr><td>${new Date(item.occurredAt).toLocaleString('es-MX')}</td><td>${safe(item.user?.fullName || 'Sistema')}</td><td><span class="badge bg-primary-subtle text-primary">${safe(item.action)}</span></td><td>${safe(item.entityName)}</td><td>${safe(item.ipAddress || '-')}</td><td>${safe(item.description || '-')}</td></tr>`).join('') : '<tr><td colspan="6" class="text-center text-muted py-4">No hay actividades para los filtros seleccionados.</td></tr>';
    };
    document.getElementById('searchLogs').addEventListener('click', load);
    document.getElementById('refreshLogs').addEventListener('click', load);
    load();
})();
</script>
}